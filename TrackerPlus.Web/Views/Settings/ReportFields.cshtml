@model TrackerPlus.Core.Models.ReportFieldsDto
@{
    var isPopup = Context.Request.Query["popup"] == "1";
    Layout = isPopup ? null : "_LiveLayout";
    ViewData["Title"] = L["Settings_ReportFields"].Value;
}
@if (!isPopup)
{
    @Html.Raw($"<div class='container py-4'><div class='row justify-content-center'><div class='col-md-6 col-lg-5'><div class='card shadow-sm'><div class='card-header bg-white fw-semibold'>{L["Settings_ReportFields"].Value}</div><div class='card-body'>")
}
<form method="post" asp-action="ReportFields">
    @Html.AntiForgeryToken()
    <input type="hidden" name="popup" value="@(isPopup ? "1" : "0")" />

    <div class="mb-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="voltage" name="Voltage"
                   value="true" @(Model.Voltage ? "checked" : "") />
            <input type="hidden" name="Voltage" value="false" />
            <label class="form-check-label" for="voltage">@L["Settings_FieldVoltage"]</label>
        </div>
    </div>
    <div class="mb-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="gps" name="Gps"
                   value="true" @(Model.Gps ? "checked" : "") />
            <input type="hidden" name="Gps" value="false" />
            <label class="form-check-label" for="gps">@L["Settings_FieldGps"]</label>
        </div>
    </div>
    <div class="mb-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="lbs" name="Lbs"
                   value="true" @(Model.Lbs ? "checked" : "") />
            <input type="hidden" name="Lbs" value="false" />
            <label class="form-check-label" for="lbs">@L["Settings_FieldLbs"]</label>
        </div>
    </div>
    <div class="mb-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="gsm" name="Gsm"
                   value="true" @(Model.Gsm ? "checked" : "") />
            <input type="hidden" name="Gsm" value="false" />
            <label class="form-check-label" for="gsm">@L["Settings_FieldGsm"]</label>
        </div>
    </div>
    <div class="mb-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="memo" name="Memo"
                   value="true" @(Model.Memo ? "checked" : "") />
            <input type="hidden" name="Memo" value="false" />
            <label class="form-check-label" for="memo">@L["Settings_FieldMemo"]</label>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="reset" class="btn btn-outline-secondary btn-sm">@L["Common_Reset"]</button>
        <button type="submit" class="btn btn-primary btn-sm">@L["Common_Ok"]</button>
    </div>
</form>
@if (!isPopup)
{
    @Html.Raw("</div></div></div></div></div></div>")
}
