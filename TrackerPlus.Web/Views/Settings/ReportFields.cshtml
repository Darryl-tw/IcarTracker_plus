@model TrackerPlus.Core.Models.ReportFieldsDto
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "報表欄位";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">報表欄位</div>
            <div class="card-body">
                <form method="post" asp-action="ReportFields">
                    @Html.AntiForgeryToken()

                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="voltage" name="Voltage"
                                   value="true" @(Model.Voltage ? "checked" : "") />
                            <input type="hidden" name="Voltage" value="false" />
                            <label class="form-check-label" for="voltage">電壓值</label>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="gps" name="Gps"
                                   value="true" @(Model.Gps ? "checked" : "") />
                            <input type="hidden" name="Gps" value="false" />
                            <label class="form-check-label" for="gps">GPS訊號</label>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="lbs" name="Lbs"
                                   value="true" @(Model.Lbs ? "checked" : "") />
                            <input type="hidden" name="Lbs" value="false" />
                            <label class="form-check-label" for="lbs">LBS編號</label>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="gsm" name="Gsm"
                                   value="true" @(Model.Gsm ? "checked" : "") />
                            <input type="hidden" name="Gsm" value="false" />
                            <label class="form-check-label" for="gsm">GSM訊號強度</label>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="memo" name="Memo"
                                   value="true" @(Model.Memo ? "checked" : "") />
                            <input type="hidden" name="Memo" value="false" />
                            <label class="form-check-label" for="memo">註解</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-outline-secondary">重置</button>
                        <button type="submit" class="btn btn-primary">確定</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
