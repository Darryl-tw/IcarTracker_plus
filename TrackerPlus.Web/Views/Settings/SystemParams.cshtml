@{
    var isPopup = Context.Request.Query["popup"] == "1";
    Layout = isPopup ? null : "_LiveLayout";
    ViewData["Title"] = L["Settings_SystemParams"].Value;
    var currentTz = ViewBag.TimeZoneTbKey?.ToString() ?? "";
}
@if (!isPopup)
{
    @Html.Raw($"<div class='container py-4'><div class='row justify-content-center'><div class='col-md-6 col-lg-5'><div class='card shadow-sm'><div class='card-header bg-white fw-semibold'>{L["Settings_SystemParamsTitle"].Value}</div><div class='card-body'>")
}
<form method="post" asp-action="SystemParams">
    @Html.AntiForgeryToken()
    <input type="hidden" name="popup" value="@(isPopup ? "1" : "0")" />

    <div class="mb-3">
        <label class="form-label fw-semibold">@L["Settings_SystemUnit"]</label>
        <div class="d-flex gap-4">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="userUnit" id="unitK"
                       value="K" @(ViewBag.UserUnit == "K" ? "checked" : "") />
                <label class="form-check-label" for="unitK">@L["Settings_UnitMetric"]</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="userUnit" id="unitM"
                       value="M" @(ViewBag.UserUnit == "M" ? "checked" : "") />
                <label class="form-check-label" for="unitM">@L["Settings_UnitImperial"]</label>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold" for="timeZoneTbKey">@L["Settings_TimeZone"]</label>
        <select class="form-select" id="timeZoneTbKey" name="timeZoneTbKey">
            @foreach (var tz in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.TimeZones)
            {
                if (tz.Value == currentTz)
                {
                    <option value="@tz.Value" selected>@tz.Text</option>
                }
                else
                {
                    <option value="@tz.Value">@tz.Text</option>
                }
            }
        </select>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-primary btn-sm">@L["Common_Ok"]</button>
    </div>
</form>
@if (!isPopup)
{
    @Html.Raw("</div></div></div></div></div>")
}
