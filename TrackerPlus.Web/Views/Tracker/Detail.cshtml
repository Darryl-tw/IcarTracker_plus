@model Tracker

@{

    Layout = "_MemberLayout";

    ViewData["Title"] = string.IsNullOrEmpty(Model.CName) ? L["Detail_Title"].Value : Model.CName;

    var timezoom = int.TryParse(User.FindFirst("Timezoom")?.Value, out var tz) ? tz : 480;

    var localTime = Model.LastReportTime.HasValue

        ? Model.LastReportTime.Value.AddMinutes(timezoom).ToString("yyyy-MM-dd HH:mm:ss")

        : "—";

}



<div class="mb-3">

    <a asp-action="Index" class="btn btn-sm btn-outline-secondary btn-with-icon">@Html.UiIcon("back")<span>@L["Detail_BackList"]</span></a>

</div>



<div class="row g-3">

    <div class="col-12 col-lg-4">

        <div class="card shadow-sm h-100">

            <div class="card-header fw-semibold">@L["Detail_Status"]</div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-5 text-muted small">IMEI</dt>

                    <dd class="col-7"><code>@Model.IMEICODE</code></dd>



                    <dt class="col-5 text-muted small">@L["Detail_DeviceName"]</dt>

                    <dd class="col-7">@(string.IsNullOrEmpty(Model.CName) ? "—" : Model.CName)</dd>



                    <dt class="col-5 text-muted small">@L["Detail_LastReport"]</dt>

                    <dd class="col-7 small">@localTime</dd>



                    <dt class="col-5 text-muted small">@L["Device_Speed"]</dt>

                    <dd class="col-7">@Model.Speed.ToString("F1") km/h</dd>



                    <dt class="col-5 text-muted small">@L["Device_Battery"]</dt>

                    <dd class="col-7">@Model.Voltage%</dd>



                    <dt class="col-5 text-muted small">@L["Detail_GpsSatellites"]</dt>

                    <dd class="col-7">@Model.GPSNo</dd>



                    <dt class="col-5 text-muted small">@L["Detail_Csq"]</dt>

                    <dd class="col-7">@Model.CSQ</dd>



                    <dt class="col-5 text-muted small">@L["Detail_Firmware"]</dt>

                    <dd class="col-7">@(string.IsNullOrEmpty(Model.FirmwareVersion) ? "—" : Model.FirmwareVersion)</dd>



                    <dt class="col-5 text-muted small">@L["Detail_LabelField"]</dt>

                    <dd class="col-7 small">@(string.IsNullOrEmpty(Model.Label) ? "—" : Model.Label)</dd>



                    <dt class="col-5 text-muted small">@L["Detail_ServiceEnd"]</dt>

                    <dd class="col-7">@(Model.ServiceEndDate.HasValue ? Model.ServiceEndDate.Value.ToString("yyyy-MM-dd") : "—")</dd>



                    <dt class="col-5 text-muted small">@L["Detail_PowerSaving"]</dt>

                    <dd class="col-7">

                        @if (Model.PowerSavingMode)

                        {

                            <span class="badge bg-warning text-dark">@L["Common_On"]</span>

                        }

                        else

                        {

                            <span class="badge bg-success">@L["Common_Off"]</span>

                        }

                    </dd>

                </dl>

                <div class="mt-3 d-flex gap-2">

                    <a asp-controller="History" asp-action="Index" asp-route-imei="@Model.IMEICODE"

                       class="btn btn-sm btn-outline-secondary flex-fill btn-with-icon">@Html.UiIcon("history")<span>@L["Detail_HistoryLink"]</span></a>

                    <a asp-controller="Map" asp-action="Live"

                       class="btn btn-sm btn-outline-success flex-fill btn-with-icon">@Html.UiIcon("map")<span>@L["Detail_LiveMapLink"]</span></a>

                </div>

            </div>

        </div>

    </div>



    <div class="col-12 col-lg-4">

        <div class="card shadow-sm">

            <div class="card-header fw-semibold">@L["Detail_BasicInfo"]</div>

            <div class="card-body">

                <form method="post" asp-action="UpdateInfo">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="tbKey" value="@Model.TbKey" />

                    <div class="mb-3">

                        <label class="form-label small fw-semibold">@L["Detail_DeviceName"]</label>

                        <input type="text" name="cname" value="@Model.CName" class="form-control form-control-sm" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label small fw-semibold">@L["Detail_Memo"]</label>

                        <textarea name="memo" class="form-control form-control-sm" rows="3">@Model.Memo</textarea>

                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100 btn-with-icon">@Html.UiIcon("save")<span>@L["Detail_SaveBasic"]</span></button>

                </form>

            </div>

        </div>

    </div>



    <div class="col-12 col-lg-4">

        <div class="card shadow-sm">

            <div class="card-header fw-semibold">@L["Detail_Labels"]</div>

            <div class="card-body">

                @{

                    var memberLabels = ViewBag.MemberLabels as IEnumerable<TrackerPlus.Core.Models.UdLabel> ?? Enumerable.Empty<TrackerPlus.Core.Models.UdLabel>();

                    var assigned = ViewBag.AssignedLabelIds as HashSet<int> ?? new HashSet<int>();

                }

                <form method="post" asp-action="UpdateLabels">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="tbKey" value="@Model.TbKey" />

                    @if (!memberLabels.Any())

                    {

                        <p class="small text-muted mb-2">@L["Detail_NoLabels"]</p>

                    }

                    @foreach (var lbl in memberLabels)

                    {

                        <div class="form-check">

                            <input class="form-check-input" type="checkbox" name="labelTbKeys" value="@lbl.TbKey"

                                   id="lbl_@lbl.TbKey" checked="@assigned.Contains(lbl.TbKey)" />

                            <label class="form-check-label" for="lbl_@lbl.TbKey">@lbl.LabelName</label>

                        </div>

                    }

                    <button type="submit" class="btn btn-primary btn-sm w-100 mt-2 btn-with-icon">@Html.UiIcon("save")<span>@L["Detail_SaveLabels"]</span></button>

                </form>

                <hr class="my-3" />

                <form method="post" asp-action="CreateLabel" class="row g-2">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="returnTrackerTbKey" value="@Model.TbKey" />

                    <div class="col-8">

                        <input type="text" name="labelName" class="form-control form-control-sm" placeholder="@L["Detail_NewLabel"]" required />

                    </div>

                    <div class="col-4">

                        <button type="submit" class="btn btn-outline-success btn-sm w-100 btn-with-icon">@Html.UiIcon("add")<span>@L["Detail_AddLabel"]</span></button>

                    </div>

                </form>

            </div>

        </div>

    </div>



    <div class="col-12 col-lg-4">

        <div class="card shadow-sm">

            <div class="card-header fw-semibold">@L["Detail_Advanced"]</div>

            <div class="card-body">

                <form method="post" asp-action="UpdateOption">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="tbKey" value="@Model.TbKey" />

                    <div class="mb-3">

                        <label class="form-label small fw-semibold">@L["Detail_Sos"]</label>

                        <input type="tel" name="sosNumber" value="@Model.SosNumber" class="form-control form-control-sm"

                               placeholder="@L["Detail_SosPlaceholder"]" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label small fw-semibold">@L["Detail_PowerSaving"]</label>

                        <select name="powerSavingMode" class="form-select form-select-sm">

                            <option value="N" selected="@(!Model.PowerSavingMode)">@L["Detail_PowerSavingNormal"]</option>

                            <option value="Y" selected="@(Model.PowerSavingMode)">@L["Detail_PowerSavingEco"]</option>

                        </select>

                        <div class="form-text">@L["Detail_PowerSavingHint"]</div>

                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100 btn-with-icon">@Html.UiIcon("save")<span>@L["Detail_SaveAdvanced"]</span></button>

                </form>

            </div>

        </div>

    </div>

</div>


