@using TrackerPlus.Core.Common
@model PagedResult<TrackerPlus.Core.Models.Member>
@{
    ViewData["Title"] = L["Admin_Member_Title"].Value;
    var filter = ViewBag.Filter as QueryFilter ?? new QueryFilter();
}
<div class="d-flex justify-content-between mb-3">
    <h2>@L["Admin_Member_Title"]</h2>
    <a asp-area="Admin" asp-action="Create" class="btn btn-success btn-with-icon">@Html.UiIcon("add")<span>+ @L["Admin_Member_Add"]</span></a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="keyword" value="@filter.Keyword" class="form-control" placeholder="@L["Admin_Member_SearchPh"]" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">@L["Common_All"]@L["Common_Status"]</option>
            <option value="Y" selected="@(filter.Status == "Y")">@L["Common_Active"]</option>
            <option value="N" selected="@(filter.Status == "N")">@L["Common_Inactive"]</option>
            <option value="D" selected="@(filter.Status == "D")">@L["Common_Disabled"]</option>
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary btn-with-icon">@Html.UiIcon("search")<span>@L["Common_Search"]</span></button></div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th>TbKey</th>
                <th>@L["Admin_Member_Account"]</th>
                <th>@L["Admin_Member_Name"]</th>
                <th>Email</th>
                <th>@L["Common_Status"]</th>
                <th>@L["Field_Language"]</th>
                <th>@L["Field_CreatedDate"]</th>
                <th>@L["Common_Operation"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td>@m.TbKey</td>
                    <td>@m.ID</td>
                    <td>@m.CName</td>
                    <td>@m.Email</td>
                    <td>
                        <span class="badge @(m.MemberStatus == "Y" ? "bg-success" : m.MemberStatus == "D" ? "bg-danger" : "bg-secondary")">
                            @m.MemberStatus
                        </span>
                    </td>
                    <td>@m.UserLanguage</td>
                    <td>@m.CDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@m.TbKey" class="btn btn-sm btn-info btn-with-icon">@Html.UiIcon("details")<span>@L["Common_Details"]</span></a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('@string.Format(L["Common_ConfirmDeleteItem"].Value, m.ID)')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.TbKey" />
                            <button type="submit" class="btn btn-sm btn-danger btn-with-icon">@Html.UiIcon("delete")<span>@L["Common_Delete"]</span></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center">
    <span>@string.Format(L["Common_TotalRecords"].Value, Model.TotalCount)，@string.Format(L["Common_PageInfo"].Value, Model.PageIndex, Model.TotalPages)</span>
    <div>
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-keyword="@filter.Keyword"
               asp-route-status="@filter.Status" class="btn btn-sm btn-outline-secondary btn-with-icon">@Html.UiIcon("prev")<span>@L["Common_PreviousPage"]</span></a>
        }
        @if (Model.HasNextPage)
        {
            <a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-keyword="@filter.Keyword"
               asp-route-status="@filter.Status" class="btn btn-sm btn-outline-secondary btn-with-icon">@Html.UiIcon("next")<span>@L["Common_NextPage"]</span></a>
        }
    </div>
</div>
