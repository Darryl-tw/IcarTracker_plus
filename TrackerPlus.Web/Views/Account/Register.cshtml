@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = L["Register_PageTitle"].Value;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Register_PageTitle"] - @L["AppName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f0f4f8; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 0; }
        .register-card { width: 100%; max-width: 500px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.12); }
        .card-header { background: linear-gradient(135deg, #2563eb, #1d4ed8); border-radius: 12px 12px 0 0 !important; }
        .btn-primary { background: #2563eb; border-color: #2563eb; font-weight: 600; }
        .btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; }
    </style>
</head>
<body>
<div class="register-card">
    <div class="card">
        <div class="card-header text-white text-center py-3">
            <h4 class="mb-0 fw-bold">@L["Register_Heading"]</h4>
            <small class="opacity-75">@L["Register_Subtitle"]</small>
        </div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            @if (!string.IsNullOrEmpty(ViewBag.Success as string))
            {
                <div class="alert alert-success py-2">@ViewBag.Success</div>
                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-with-icon">@Html.UiIcon("login")<span>@L["Register_BackLogin"]</span></a>
                </div>
            }
            else
            {
                <form method="post" asp-controller="Account" asp-action="Register">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Register_Account"] <span class="text-danger">@L["Common_Required"]</span></label>
                            <input type="text" name="ID" class="form-control" placeholder="@L["Register_AccountPh"]" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Login_Password"] <span class="text-danger">@L["Common_Required"]</span></label>
                            <input type="password" name="password" class="form-control" placeholder="@L["Register_PasswordPh"]" required minlength="8" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Register_Name"] <span class="text-danger">@L["Common_Required"]</span></label>
                            <input type="text" name="CName" class="form-control" placeholder="@L["Register_NamePh"]" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Register_Email"] <span class="text-danger">@L["Common_Required"]</span></label>
                            <input type="email" name="Email" class="form-control" placeholder="@L["Register_EmailPh"]" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Register_Phone"]</label>
                            <input type="tel" name="Tel" class="form-control" placeholder="@L["Register_PhonePh"]" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">@L["Register_Language"]</label>
                            <select name="UserLanguage" class="form-select">
                                <option value="CHT">@L["Lang_CHT"]</option>
                                <option value="CHS">@L["Lang_CHS"]</option>
                                <option value="ENG">@L["Lang_ENG"]</option>
                            </select>
                        </div>
                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-primary w-100 py-2 btn-with-icon">@Html.UiIcon("register")<span>@L["Register_Submit"]</span></button>
                        </div>
                    </div>
                </form>
                <hr />
                <div class="text-center">
                    <small>@L["Register_HasAccount"]</small>
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none ms-1">
                        <small class="fw-semibold">@L["Register_BackLogin"]</small>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
