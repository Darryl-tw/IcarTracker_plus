@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = L["ForgotPassword_Title"].Value;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["ForgotPassword_Title"] - @L["AppName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f0f4f8; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.12); width: 100%; max-width: 420px; }
        .card-header { background: linear-gradient(135deg, #2563eb, #1d4ed8); border-radius: 12px 12px 0 0 !important; }
        .btn-primary { background: #2563eb; border-color: #2563eb; font-weight: 600; }
        .btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; }
    </style>
</head>
<body>
<div class="card">
    <div class="card-header text-white text-center py-3">
        <h5 class="mb-0 fw-bold">@L["ForgotPassword_Title"]</h5>
        <small class="opacity-75">@L["ForgotPassword_Subtitle"]</small>
    </div>
    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert alert-danger py-2">@ViewBag.Error</div>
        }
        @if (!string.IsNullOrEmpty(ViewBag.Success as string))
        {
            <div class="alert alert-success py-2">@ViewBag.Success</div>
        }
        <form method="post" asp-controller="Account" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-semibold">@L["ForgotPassword_EmailLabel"]</label>
                <input type="email" name="email" class="form-control" placeholder="@L["ForgotPassword_EmailPh"]" required autofocus />
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-with-icon">@Html.UiIcon("confirm")<span>@L["ForgotPassword_Submit"]</span></button>
        </form>
        <hr />
        <div class="text-center">
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none">
                <small>@L["ForgotPassword_BackLogin"]</small>
            </a>
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
