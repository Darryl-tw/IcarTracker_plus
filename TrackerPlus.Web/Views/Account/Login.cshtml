@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = L["Login_Title"].Value;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Login_Title"] - @L["AppName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: #1a1d23; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { width: 100%; max-width: 420px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
        .card-header { background: linear-gradient(135deg, #2563eb, #1d4ed8); border-radius: 12px 12px 0 0 !important; padding: 1.5rem; }
        .brand-icon { font-size: 2rem; margin-bottom: 0.5rem; }
    </style>
</head>
<body>
<div class="login-card">
    <div class="card">
        <div class="card-header text-white text-center">
            <div class="brand-icon">📡</div>
            <h4 class="mb-0 fw-bold">@L["AppName"]</h4>
            <small class="opacity-75">@L["AppSubtitle"]</small>
            @{
                ViewData["LangSwitcherVariant"] = "pills";
            }
            <partial name="_LanguageSwitcher" />
        </div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            <form method="post" asp-controller="Account" asp-action="Login">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">@L["Login_Account"]</label>
                    <input type="text" name="id" class="form-control" placeholder="@L["Login_PlaceholderAccount"]" required autofocus />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">@L["Login_Password"]</label>
                    <input type="password" name="password" class="form-control" placeholder="@L["Login_PlaceholderPassword"]" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-with-icon">@Html.UiIcon("login")<span>@L["Login_Submit"]</span></button>
            </form>
            <hr class="my-3" />
            <div class="text-center">
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none me-3">
                    <small>@L["Login_NoAccount"]</small>
                </a>
                <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none">
                    <small>@L["Login_ForgotPassword"]</small>
                </a>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
