@if (!string.IsNullOrEmpty(googleApiJs))
{
    <script src="@googleApiJs&callback=initMap&loading=async" async defer></script>
}
else
{
    <script>
        document.getElementById('no-map-msg').style.display = 'block';
        document.getElementById('map-toolbar').style.display = 'none';
        const mts = document.getElementById('map-type-switch');
        if (mts) mts.style.display = 'none';
    </script>
}
}
