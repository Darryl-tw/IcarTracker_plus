// ========== DEVICE SETTINGS MODAL ==========
let deviceSettingsControlsBuilt = false;

function initDeviceSettingsControls() {
    if (deviceSettingsControlsBuilt) return;
    deviceSettingsControlsBuilt = true;
    const gps = document.getElementById('dsm-gps-interval');
    if (gps) {
        gps.innerHTML = [
            [15, i18n.gps15s], [30, i18n.gps30s], [600, i18n.gps10m],
            [1800, i18n.gps30m], [3600, i18n.gps60m], [7200, i18n.gps120m]
        ].map(([v, t]) => `<option value="${v}">${t}</option>`).join('');
    }
    const shock = document.getElementById('dsm-shock-sensitive');
    if (shock) {
        let num = 0;
        shock.innerHTML = '';
        for (let i = -4; i <= 4; i++) {
            num++;
            const label = i > 0 ? '+' + i : String(i);
            shock.innerHTML += `<option value="${num}">${label}</option>`;
        }
    }
    const ap = document.getElementById('dsm-ap-minute');
    if (ap) {
        ap.innerHTML = `<option value="0">${i18n.closed}</option>`;
        for (let m = 5; m <= 180; m += 5) ap.innerHTML += `<option value="${m}">${m}</option>`;
    }
    const as = document.getElementById('dsm-as-minute');
    if (as) {
        as.innerHTML = `<option value="0">${i18n.closed}</option>`;
        for (let m = 20; m <= 200; m += 5) as.innerHTML += `<option value="${m}">${m}</option>`;
    }
    ['dsm-spw1', 'dsm-spw2', 'dsm-spw3', 'dsm-spw4'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.innerHTML = Array.from({ length: 10 }, (_, d) => `<option value="${d}">${d}</option>`).join('');
    });
}

function switchDeviceSettingsTab(tab) {
    document.querySelectorAll('#device-settings-modal .dsm-tab').forEach(el => {
        el.classList.toggle('active', el.dataset.tab === tab);
    });
    document.querySelectorAll('#device-settings-modal .dsm-pane').forEach(el => {
        el.classList.toggle('active', el.id === 'dsm-pane-' + tab);
    });
}

function toggleSharePassword() {
    const on = document.getElementById('dsm-share-enable').checked;
    document.querySelectorAll('.dsm-pw').forEach(el => { el.disabled = !on; });
}

function buildIconChoices() {
    const box = document.getElementById('device-settings-icons');
    if (!box || box.dataset.built === '1') return;
    box.innerHTML = ICON_LETTERS.map(letter => `
        <div class="icon-choice" data-icon="${letter}" onclick="selectDeviceIcon('${letter}')">
            <img src="/images/map-icons/Icon${letter}/dir_0.png" alt="${ICON_LABELS[letter]}" />
            <span>${ICON_LABELS[letter]}</span>
        </div>
    `).join('');
    box.dataset.built = '1';
}

function selectDeviceIcon(letter) {
    document.querySelectorAll('#device-settings-icons .icon-choice').forEach(el => {
        el.classList.toggle('selected', el.dataset.icon === letter);
    });
    document.getElementById('device-settings-modal').dataset.iconFile = letter;
}

function fillDeviceSettingsForm(data) {
    document.getElementById('dsm-tbkey').value = data.tbKey;
    document.getElementById('dsm-imei').value = data.imei;
    document.getElementById('dsm-cname').value = data.cName || data.cname || '';
    document.getElementById('dsm-hint').textContent = i18n.deviceSettingsHint.replace('{0}', data.imei);
    selectDeviceIcon((data.iconFile || 'A').toUpperCase());

    const udBox = document.getElementById('dsm-ud-fields');
    const fields = data.udFields || [];
    if (fields.length === 0) {
        udBox.innerHTML = '';
    } else {
        udBox.innerHTML = fields.map(f => `
            <div class="mb-2">
                <label>${escapeHtml(f.fieldName)}</label>
                <input type="text" class="form-control form-control-sm dsm-udf" data-field-tbkey="${f.fieldTbKey}" maxlength="20" value="${escapeHtml(f.value || '')}" />
            </div>
        `).join('');
    }

    const labelsBox = document.getElementById('device-settings-labels');
    const labels = data.labels || [];
    if (labels.length === 0) {
        labelsBox.innerHTML = `<span class="text-muted small">${i18n.noLabels}</span>`;
    } else {
        labelsBox.innerHTML = labels.map(l => `
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="dsm-lbl-${l.tbKey}" value="${l.tbKey}" ${l.assigned ? 'checked' : ''} />
                <label class="form-check-label" for="dsm-lbl-${l.tbKey}">${escapeHtml(l.name)}</label>
            </div>
        `).join('');
    }

    document.getElementById('dsm-gps-interval').value = String(data.gpsReportTime || 30);
    document.getElementById('dsm-shock-mode').value = String(data.shockMode || 1);
    document.getElementById('dsm-shock-sensitive').value = String(data.shockSensitive || 5);
    document.getElementById('dsm-ap-minute').value = String(data.apMinute || 0);
    document.getElementById('dsm-ap-msg').value = data.apMsg || data.imei || '';
    document.getElementById('dsm-as-minute').value = String(data.asMinute || 0);
    document.getElementById('dsm-as-msg').value = data.asMsg || data.imei || '';

    const shareOn = !!data.shareEnabled;
    document.getElementById('dsm-share-enable').checked = shareOn;
    const pwd = (data.sharePassword || '0000').padStart(4, '0').slice(0, 4);
    ['dsm-spw1', 'dsm-spw2', 'dsm-spw3', 'dsm-spw4'].forEach((id, i) => {
        document.getElementById(id).value = pwd[i] || '0';
    });
    toggleSharePassword();
    document.getElementById('dsm-alert-mode').value = String(data.alertMode || 0);

    const payBox = document.getElementById('device-settings-paylog');
    const logs = data.payLogs || [];
    if (logs.length === 0) {
        payBox.innerHTML = '<p class="text-muted small mb-0">' + i18n.histNoData + '</p>';
    } else {
        payBox.innerHTML = `<table><thead><tr><th>${i18n.serviceStart}</th><th>${i18n.serviceEnd}</th></tr></thead><tbody>` +
            logs.map((p, i) => {
                const s = p.serviceStart ? formatDateYmd(p.serviceStart) : TEXT_DASH;
                const e = p.serviceEnd ? formatDateYmd(p.serviceEnd) : TEXT_DASH;
                return `<tr class="${i === 0 ? 'highlight' : ''}"><td>${s}</td><td>${e}</td></tr>`;
            }).join('') + '</tbody></table>';
    }
}

function formatDateYmd(iso) {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
}

let deviceSettingsModalGuardBound = false;
function ensureDeviceSettingsModalGuard() {
    if (deviceSettingsModalGuardBound) return;
    deviceSettingsModalGuardBound = true;
    const overlay = document.getElementById('device-settings-overlay');
    overlay.addEventListener('mousedown', function (e) {
        if (e.target === overlay) {
            e.preventDefault();
            e.stopPropagation();
        }
    });
    document.addEventListener('keydown', function (e) {
        if (!overlay.classList.contains('visible')) return;
        if (e.key === 'Escape') {
            e.preventDefault();
            e.stopPropagation();
        }
    }, true);
}

function openDeviceSettings(tbKey) {
    ensureDeviceSettingsModalGuard();
    initDeviceSettingsControls();
    buildIconChoices();
    switchDeviceSettingsTab('info');
    const overlay = document.getElementById('device-settings-overlay');
    overlay.classList.add('visible');
    $.getJSON(`/Map/DeviceSettings?tbKey=${tbKey}`, function (data) {
        try {
            deviceSettingsSnapshot = JSON.parse(JSON.stringify(data));
            fillDeviceSettingsForm(data);
        } catch (err) {
            overlay.classList.remove('visible');
            console.error('fillDeviceSettingsForm failed', err);
            alert(i18n.deviceSettingsLoadFailed);
        }
    }).fail(function (xhr) {
        overlay.classList.remove('visible');
        console.error('DeviceSettings failed', xhr);
        alert(i18n.deviceSettingsLoadFailed);
    });
}

function closeDeviceSettings() {
    document.getElementById('device-settings-overlay').classList.remove('visible');
}

function resetDeviceSettings() {
    if (!deviceSettingsSnapshot) return;
    fillDeviceSettingsForm(deviceSettingsSnapshot);
}

function saveDeviceSettings() {
    const tbKey = parseInt(document.getElementById('dsm-tbkey').value, 10);
    const iconFile = document.getElementById('device-settings-modal').dataset.iconFile || 'A';
    const labelTbKeys = Array.from(document.querySelectorAll('#device-settings-labels input:checked'))
        .map(el => parseInt(el.value, 10));
    const udFields = Array.from(document.querySelectorAll('.dsm-udf')).map(el => ({
        fieldTbKey: parseInt(el.dataset.fieldTbkey, 10),
        value: el.value
    }));
    let sharePassword = '0000';
    if (document.getElementById('dsm-share-enable').checked) {
        sharePassword = ['dsm-spw1', 'dsm-spw2', 'dsm-spw3', 'dsm-spw4']
            .map(id => document.getElementById(id).value).join('');
    }

    const payload = {
        tbKey: tbKey,
        cname: document.getElementById('dsm-cname').value,
        iconFile: iconFile,
        labelTbKeys: labelTbKeys,
        udFields: udFields,
        gpsReportTime: parseInt(document.getElementById('dsm-gps-interval').value, 10),
        shockMode: parseInt(document.getElementById('dsm-shock-mode').value, 10),
        shockSensitive: parseInt(document.getElementById('dsm-shock-sensitive').value, 10),
        apMinute: parseInt(document.getElementById('dsm-ap-minute').value, 10),
        apMsg: document.getElementById('dsm-ap-msg').value,
        asMinute: parseInt(document.getElementById('dsm-as-minute').value, 10),
        asMsg: document.getElementById('dsm-as-msg').value,
        shareEnabled: document.getElementById('dsm-share-enable').checked,
        sharePassword: sharePassword,
        alertMode: parseInt(document.getElementById('dsm-alert-mode').value, 10)
    };

    $.ajax({
        url: '/Map/SaveDeviceSettings',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        success: function (res) {
            if (!res.success) {
                alert(res.message || i18n.deviceSettingsSaveFailed);
                return;
            }
            const m = markers[tbKey];
            if (m && m.markerData) {
                m.markerData.cname = payload.cname;
                m.markerData.iconFile = iconFile;
                m.setTitle(payload.cname || m.markerData.imei);
                updateMarkerIcon(tbKey);
            }
            const item = document.querySelector(`.device-item[data-tbkey="${tbKey}"]`);
            if (item) {
                const nameEl = item.querySelector('.device-name');
                if (nameEl) nameEl.textContent = payload.cname || item.dataset.imei;
            }
            refreshData();
            $.getJSON(`/Map/DeviceSettings?tbKey=${tbKey}`, function (data) {
                deviceSettingsSnapshot = JSON.parse(JSON.stringify(data));
            });
            const hint = document.getElementById('dsm-hint');
            if (hint) {
                const imei = document.getElementById('dsm-imei').value;
                const savedMsg = i18n.deviceSettingsSaved;
                hint.textContent = savedMsg;
                hint.style.color = '#16a34a';
                window.setTimeout(function () {
                    hint.textContent = i18n.deviceSettingsHint.replace('{0}', imei);
                    hint.style.color = '';
                }, 2500);
            }
        },
        error: function () {
            alert(i18n.deviceSettingsSaveFailed);
        }
    });
}

// ========== MAP DEVICE DETAIL (double-click marker) ==========
function decToDeg(dec, type) {
    const n = parseFloat(dec);
    if (isNaN(n)) return dec;
    const abs = Math.abs(n);
    const d = Math.floor(abs);
    const m = Math.floor((abs - d) * 60);
    const s = ((abs - d) * 60 - m) * 60;
    const hemi = type === 'lat' ? (n >= 0 ? 'N' : 'S') : (n >= 0 ? 'E' : 'W');
    return `${d}\u00B0 ${m}' ${s.toFixed(2)}", ${hemi}`;
}

function showDeviceDetail(tbKey) {
    closePopup();
    $.getJSON(`/Map/DeviceDetail?tbKey=${tbKey}`, function (d) {
        const m = markers[tbKey];
        let lat = d.lat;
        let lng = d.lng;
        if (m && m.markerData && (Math.abs(lat) < 0.0001 && Math.abs(lng) < 0.0001)) {
            lat = m.markerData.lat;
            lng = m.markerData.lng;
        }

        document.getElementById('dd-title').textContent = d.cName || d.imei;
        const statusText = d.isOnline ? i18n.detailOnline : i18n.detailOffline;
        const statusColor = d.isOnline ? '#2563eb' : '#94a3b8';
        document.getElementById('dd-status').innerHTML = '<span style="color:' + statusColor + '">\u25CF</span> <b>' + statusText + '</b>';

        let connectLine = d.lastConnectedLocal || i18n.unknown;
        if (!d.isOnline && d.offlineDuration) {
            connectLine += ` (${i18n.detailOffline} ${d.offlineDuration})`;
        }

        const speedVal = (m && m.markerData && typeof m.markerData.speed === 'number') ? m.markerData.speed : (d.speedKmh || 0);
        const speedStr = i18n.unitKmValue.replace('{0}', speedVal.toFixed(1));
        const distStr = i18n.unitMeterValue.replace('{0}', String(Math.round(d.distanceMeters || 0)));
        const coordDms = decToDeg(lat, 'lat') + ', ' + decToDeg(lng, 'lng');
        const coordDec = `(${lat.toFixed(6)}, ${lng.toFixed(6)})`;

        const ddRow = (label, value) =>
            '<div class="dd-row"><span class="dd-meta">' + label + LABEL_COLON + '</span>' + value + '</div>';
        document.getElementById('dd-body').innerHTML =
            ddRow(i18n.detailLastLogin, d.lastLoginLocal || TEXT_DASH) +
            ddRow(i18n.detailLastGps, d.lastReportLocal || TEXT_DASH) +
            ddRow(i18n.detailLastConnect, connectLine) +
            '<hr style="border-color:#e2e8f0;margin:8px 0" />' +
            ddRow(i18n.detailTravelSpeed, speedStr) +
            ddRow(i18n.detailDistance, distStr) +
            ddRow(i18n.detailCoords, '<a href="https://maps.google.com.tw/maps?q=' + lat + ',' + lng + '" target="_blank" style="color:#dc2626">' + coordDms + '</a> &nbsp;' + coordDec) +
            ddRow(i18n.detailAddress, '<span id="dd-address">\u2026</span>') +
            ddRow(i18n.detailDirection, d.directionText || TEXT_DASH);

        const csq = (m && m.markerData && m.markerData.csq) ? m.markerData.csq : d.csq;
        const vPct = d.voltagePercent || 0;
        const vV = d.voltageV ? d.voltageV.toFixed(2) : '';
        document.getElementById('dd-icons').innerHTML = `
            <div>CSQ: ${csq}</div>
            <div>${i18n.detailSatellites}: ${d.gpsUsed || 0}/${d.gpsTotal || 12}</div>
            <div>${i18n.detailLithium} [&gt;${vPct}%] ${vV}V</div>
        `;

        document.getElementById('device-detail-overlay').classList.add('visible');
        if (geocoder && Math.abs(lat) > 0.0001 && Math.abs(lng) > 0.0001) {
            geocoder.geocode({ location: { lat: lat, lng: lng } }, (results, status) => {
                const el = document.getElementById('dd-address');
                if (!el) return;
                el.textContent = (status === 'OK' && results[0]) ? results[0].formatted_address : TEXT_DASH;
            });
        } else {
            const el = document.getElementById('dd-address');
            if (el) el.textContent = TEXT_DASH;
        }
        if (m) {
            map.panTo(m.getPosition());
            map.setZoom(15);
        }
    });
}

function closeDeviceDetail() {
    document.getElementById('device-detail-overlay').classList.remove('visible');
}

// ========== REFRESH ==========
function stopRefresh() {
    if (refreshTickTimer) {
        clearInterval(refreshTickTimer);
        refreshTickTimer = null;
    }
}

function updateRefreshCountdownDisplay() {
    const el = document.getElementById('refresh-countdown');
    if (el) el.textContent = String(REFRESH_SECONDS - refreshClock);
}

function refreshTick() {
    if (refreshClock < REFRESH_SECONDS) {
        updateRefreshCountdownDisplay();
        refreshClock++;
    } else {
        refreshClock = 0;
        refreshData();
    }
}

function startRefreshCycle() {
    stopRefresh();
    refreshClock = 0;
    refreshTickTimer = setInterval(refreshTick, 1000);
}

function startRefresh() {
    refreshData();
    startRefreshCycle();
}

function forceRefresh() {
    stopRefresh();
    refreshClock = 0;
    refreshData();
    startRefreshCycle();
}

function refreshData() {
    $.getJSON('/Map/LiveData', function (data) {
        data.forEach(function (t) {
            t.iconFile = (t.iconFile || 'A').toString().toUpperCase();
            if (markers[t.tbKey] && markers[t.tbKey].markerData) {
                Object.assign(markers[t.tbKey].markerData, t);
            }
            renderMarker(t);
            updateMarkerIcon(t.tbKey);
            if (selectedTbKey === t.tbKey) updateMapDeviceStatusBar(t.tbKey);
            // update sidebar row
            const item = document.querySelector(`.device-item[data-tbkey="${t.tbKey}"]`);
            if (item) {
                const nameEl = item.querySelector('.device-name');
                if (nameEl && t.cname) nameEl.textContent = t.cname;
                const dot = item.querySelector('.status-dot');
                if (dot) {
                    const status = getDeviceStatus(t.isOnline, item.dataset.powerSaving === 'true', item.dataset.serviceDays);
                    dot.className = 'status-dot ' + status;
                }
                item.classList.toggle('offline', !t.isOnline);
            }
        });
        document.getElementById('device-count').textContent = data.length;
        showRefreshStatus(i18n.refreshUpdated.replace('{0}', new Date().toLocaleTimeString()));
    });
}

function getDeviceStatus(isOnline, powerSaving, serviceDaysStr) {
    if (serviceDaysStr !== '' && serviceDaysStr !== null && parseInt(serviceDaysStr, 10) <= 0) return 'terminated';
    if (isOnline) return 'online';
    return powerSaving ? 'sleeping' : 'disconnected';
}

function showRefreshStatus(msg) {
    const el = document.getElementById('refresh-badge');
    el.textContent = msg;
    el.style.opacity = '1';
    setTimeout(() => { el.style.opacity = '0'; }, 3000);
}

// ========== SIDEBAR RESIZE ==========
const SIDEBAR_WIDTH_KEY = 'live-sidebar-w-v1';

function initSidebarResize() {
    const handle = document.getElementById('sidebar-resize-handle');
    const sidebar = document.getElementById('left-sidebar');
    if (!handle || !sidebar) return;

    const saved = localStorage.getItem(SIDEBAR_WIDTH_KEY);
    if (saved) {
        const w = parseInt(saved, 10);
        if (Number.isFinite(w)) sidebar.style.width = w + 'px';
    }

    let dragging = false;
    let startX = 0;
    let startW = 0;
    let raf = 0;

    const MIN_W = parseInt(getComputedStyle(sidebar).minWidth) || 140;
    const MAX_W = parseInt(getComputedStyle(sidebar).maxWidth) || 480;

    function clamp(w) { return Math.min(MAX_W, Math.max(MIN_W, w)); }

    function onMove(clientX) {
        const delta = clientX - startX;
        sidebar.style.width = clamp(startW + delta) + 'px';
        if (!raf) raf = requestAnimationFrame(() => { raf = 0; triggerMapResize(); });
    }

    function endDrag() {
        if (!dragging) return;
        dragging = false;
        handle.classList.remove('dragging');
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        localStorage.setItem(SIDEBAR_WIDTH_KEY, String(parseInt(sidebar.style.width) || sidebar.offsetWidth));
        triggerMapResize();
    }

    handle.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        e.preventDefault();
        dragging = true;
        startX = e.clientX;
        startW = sidebar.offsetWidth;
        handle.classList.add('dragging');
        document.body.style.cursor = 'ew-resize';
        document.body.style.userSelect = 'none';
    });

    handle.addEventListener('touchstart', (e) => {
        if (!e.touches.length) return;
        e.preventDefault();
        dragging = true;
        startX = e.touches[0].clientX;
        startW = sidebar.offsetWidth;
        handle.classList.add('dragging');
    }, { passive: false });

    window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        e.preventDefault();
        onMove(e.clientX);
    });

    window.addEventListener('touchmove', (e) => {
        if (!dragging || !e.touches.length) return;
        e.preventDefault();
        onMove(e.touches[0].clientX);
    }, { passive: false });

    window.addEventListener('mouseup', endDrag);
    window.addEventListener('touchend', endDrag);
    window.addEventListener('touchcancel', endDrag);
}

// ========== HISTORY PANEL RESIZE ==========
const HIST_PANEL_HEIGHT_KEY = 'live-hist-panel-h-v2';
const MAP_AREA_MIN_H = 120;

function getHistPanelDefaultHeight() {
    const style = getComputedStyle(document.documentElement);
    const h = parseFloat(style.getPropertyValue('--live-hist-panel-h'));
    return Number.isFinite(h) && h > 0 ? Math.round(h) : 210;
}

function getHistPanelMinHeight() {
    const style = getComputedStyle(document.documentElement);
    const toolbar = parseFloat(style.getPropertyValue('--live-hist-toolbar-h')) || 34;
    const row = parseFloat(style.getPropertyValue('--live-hist-table-row-h')) || 22;
    return Math.round(toolbar + 4 * row);
}

function getHistPanelHeight() {
    const v = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--live-hist-panel-h'));
    return Number.isFinite(v) && v > 0 ? Math.round(v) : getHistPanelDefaultHeight();
}

function setHistPanelHeight(px) {
    document.documentElement.style.setProperty('--live-hist-panel-h', `${px}px`);
}

function getMaxHistPanelHeight() {
    const rp = document.getElementById('right-panel');
    if (!rp) return 600;
    const tabs = document.getElementById('map-tabs');
    const splitter = document.getElementById('hist-resize-handle');
    const tabsH = tabs ? tabs.offsetHeight : 26;
    const splitterH = splitter && splitter.classList.contains('visible') ? splitter.offsetHeight : 0;
    const available = rp.clientHeight - tabsH - splitterH;
    return Math.max(getHistPanelMinHeight(), available - MAP_AREA_MIN_H);
}

function clampHistPanelHeight(px) {
    return Math.min(getMaxHistPanelHeight(), Math.max(getHistPanelMinHeight(), px));
}

function triggerMapResize() {
    if (map) google.maps.event.trigger(map, 'resize');
}

function setHistResizeHandleVisible(visible) {
    const handle = document.getElementById('hist-resize-handle');
    if (handle) handle.classList.toggle('visible', visible);
}

function initHistPanelResize() {
    const handle = document.getElementById('hist-resize-handle');
    if (!handle) return;

    const saved = localStorage.getItem(HIST_PANEL_HEIGHT_KEY);
    if (saved) {
        const h = parseInt(saved, 10);
        if (Number.isFinite(h)) setHistPanelHeight(clampHistPanelHeight(h));
    } else {
        setHistPanelHeight(getHistPanelDefaultHeight());
    }

    let dragging = false;
    let startY = 0;
    let startH = 0;
    let resizeRaf = 0;

    function onPointerMove(clientY) {
        const delta = startY - clientY;
        setHistPanelHeight(clampHistPanelHeight(startH + delta));
        if (!resizeRaf) {
            resizeRaf = requestAnimationFrame(() => {
                resizeRaf = 0;
                triggerMapResize();
            });
        }
    }

    function endDrag() {
        if (!dragging) return;
        dragging = false;
        handle.classList.remove('dragging');
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        localStorage.setItem(HIST_PANEL_HEIGHT_KEY, String(getHistPanelHeight()));
        triggerMapResize();
    }

    handle.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        e.preventDefault();
        dragging = true;
        startY = e.clientY;
        startH = getHistPanelHeight();
        handle.classList.add('dragging');
        document.body.style.cursor = 'ns-resize';
        document.body.style.userSelect = 'none';
    });

    handle.addEventListener('touchstart', (e) => {
        if (!e.touches.length) return;
        e.preventDefault();
        dragging = true;
        startY = e.touches[0].clientY;
        startH = getHistPanelHeight();
        handle.classList.add('dragging');
    }, { passive: false });

    window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        e.preventDefault();
        onPointerMove(e.clientY);
    });

    window.addEventListener('touchmove', (e) => {
        if (!dragging || !e.touches.length) return;
        e.preventDefault();
        onPointerMove(e.touches[0].clientY);
    }, { passive: false });

    window.addEventListener('mouseup', endDrag);
    window.addEventListener('touchend', endDrag);
    window.addEventListener('touchcancel', endDrag);

    window.addEventListener('resize', () => {
        if (document.getElementById('history-panel')?.classList.contains('visible')) {
            setHistPanelHeight(clampHistPanelHeight(getHistPanelHeight()));
            triggerMapResize();
        }
    });
}

// ========== TABS ==========
function switchTab(tab) {
    activeTab = tab;
    document.querySelectorAll('.map-tab').forEach(el => {
        el.classList.toggle('active', el.dataset.tab === tab);
    });

    const isLive = tab === 'live';
    document.getElementById('map-toolbar').style.display = isLive ? '' : 'none';
    const mts = document.getElementById('map-type-switch');
    if (mts) mts.style.display = isLive ? '' : 'none';
    const statusBar = document.getElementById('map-device-status-bar');
    if (statusBar) {
        if (isLive && selectedTbKey) updateMapDeviceStatusBar(selectedTbKey);
        else statusBar.classList.remove('visible');
    }
    setHistResizeHandleVisible(!isLive);
    document.getElementById('history-panel').classList.toggle('visible', !isLive);
    if (!isLive) setHistPanelHeight(clampHistPanelHeight(getHistPanelHeight()));
    document.getElementById('device-popup').style.display = 'none';

    if (!isLive) {
        // Hide live device markers so history map is clean
        Object.values(markers).forEach(m => m.setMap(null));
        Object.values(polylines).forEach(p => p.setMap(null));
        clearTracks();
        clearHistoryMap();
        stopRefresh();
        const isLbs = tab === 'history-lbs';
        const gpsCtrl = document.getElementById('hist-gps-controls');
        const lbsCtrl = document.getElementById('hist-lbs-controls');
        if (gpsCtrl) gpsCtrl.style.display = isLbs ? 'none' : 'flex';
        if (lbsCtrl) lbsCtrl.style.display = isLbs ? 'flex' : 'none';
        if (!isLbs) {
            showHistSummaryView();
            loadHistorySummary();
        } else {
            showHistSummaryView();
            loadLbsSummary();
        }
    } else {
        // Restore live device markers when returning to live tab
        Object.values(markers).forEach(m => m.setMap(map));
        Object.values(polylines).forEach(p => p.setMap(map));
        startRefresh();
        setTimeout(() => {
            if (selectedTbKey && markers[selectedTbKey]) {
                map.panTo(markers[selectedTbKey].getPosition());
                map.setZoom(15);
            } else {
                fitAll();
            }
        }, 80);
    }
    if (map) {
        setTimeout(() => google.maps.event.trigger(map, 'resize'), 50);
    }
}

// ========== HISTORY ==========

function histGpsPrev7() {
    const el = document.getElementById('hist-gps-date');
    const d = new Date(el.value);
    d.setDate(d.getDate() - 7);
    const min = new Date(el.min);
    if (d < min) d.setTime(min.getTime());
    el.value = d.toISOString().substring(0, 10);
    loadHistorySummary();
}

function histGpsNext7() {
    const el = document.getElementById('hist-gps-date');
    const d = new Date(el.value);
    d.setDate(d.getDate() + 7);
    const max = new Date(el.max);
    if (d > max) d.setTime(max.getTime());
    el.value = d.toISOString().substring(0, 10);
    loadHistorySummary();
}

function resetMapToWorld() {
    if (!map) return;
    map.setCenter({ lat: 25, lng: 110 });
    map.setZoom(4);
}

function showHistSummaryView() {
    clearHistoryMap();
    resetMapToWorld();
    document.getElementById('history-toolbar').style.display = '';
    document.getElementById('hist-summary-view').style.display = 'flex';
    document.getElementById('hist-detail-view').style.display = 'none';
    if (map) setTimeout(() => google.maps.event.trigger(map, 'resize'), 50);
}

function resetHistoryForDevice(imei) {
    clearHistoryMap();
    resetMapToWorld();
    document.getElementById('hist-summary-tbody').innerHTML = '';
    document.getElementById('hist-summary-table').style.display = 'none';
    document.getElementById('hist-summary-nodata').style.display = 'none';
    document.getElementById('hist-detail-tbody').innerHTML = '';
    document.getElementById('history-toolbar').style.display = '';
    document.getElementById('hist-summary-view').style.display = 'flex';
    document.getElementById('hist-detail-view').style.display = 'none';
    if (map) setTimeout(() => google.maps.event.trigger(map, 'resize'), 50);
    if (!imei) return;
    if (activeTab === 'history') loadHistorySummary();
    else if (activeTab === 'history-lbs') loadLbsSummary();
}

function showHistDetailView(titleText) {
    document.getElementById('history-toolbar').style.display = 'none';
    document.getElementById('hist-summary-view').style.display = 'none';
    document.getElementById('hist-detail-view').style.display = 'flex';
    document.getElementById('hist-detail-title').textContent = titleText || '';
    document.getElementById('hist-detail-table').style.display = 'none';
    document.getElementById('hist-detail-nodata').style.display = 'none';
    document.getElementById('hist-detail-tbody').innerHTML = '';
    document.getElementById('hist-detail-dist').textContent = '0';
    document.getElementById('hist-detail-maxspeed').textContent = '0';
    document.getElementById('hist-detail-avgspeed').textContent = '0';
    document.getElementById('hist-detail-count').textContent = '0';
}

function loadHistorySummary() {
    const imei = document.getElementById('hist-device-sel').value;
    const endDate = document.getElementById('hist-gps-date').value;
    if (!imei) return;

    // Reset UI
    document.getElementById('hist-loading').style.display = 'inline';
    document.getElementById('hist-summary-nodata').style.display = 'none';
    document.getElementById('hist-summary-table').style.display = 'none';
    document.getElementById('hist-summary-tbody').innerHTML = '';

    // Close any in-progress summary stream
    if (summaryStreamSource) { summaryStreamSource.close(); summaryStreamSource = null; }

    const url = `/Map/HistoryDailySummaryStream?imei=${encodeURIComponent(imei)}&endDate=${endDate}`;
    const es = new EventSource(url);
    summaryStreamSource = es;
    let hasData = false;

    es.onmessage = function(e) {
        const row = JSON.parse(e.data);

        if (row.done) {
            es.close(); summaryStreamSource = null;
            document.getElementById('hist-loading').style.display = 'none';
            if (!hasData) {
                document.getElementById('hist-summary-nodata').textContent = i18n.histNoData;
                document.getElementById('hist-summary-nodata').style.display = 'block';
            }
            return;
        }

        hasData = true;
        const tr = document.createElement('tr');
        tr.className = 'data-row';
        tr.innerHTML = `
            <td>${row.date}</td>
            <td>${row.firstGPS}</td>
            <td>${row.lastGPS}</td>
            <td>${row.duration}</td>
            <td>${row.recordCount}</td>
            <td>${row.totalKm}</td>
        `;
        if (row.recordCount > 0) {
            tr.onclick = () => loadHistoryDetail(imei, row.date);
        } else {
            tr.style.color = '#94a3b8';
        }
        document.getElementById('hist-summary-tbody').appendChild(tr);
        document.getElementById('hist-summary-table').style.display = '';
    };

    es.onerror = function() {
        if (es.readyState === EventSource.CLOSED) return;
        es.close(); summaryStreamSource = null;
        document.getElementById('hist-loading').style.display = 'none';
        document.getElementById('hist-summary-nodata').textContent = i18n.histQueryFailed;
        document.getElementById('hist-summary-nodata').style.display = 'block';
    };
}

function loadHistoryDetail(imei, date) {
    showHistDetailView(imei + '  ' + date);
    clearHistoryMap();
    startHistoryStream(imei, date, 'GPS');
}

function histLbsPrev7() {
    const el = document.getElementById('hist-lbs-date');
    const d = new Date(el.value);
    d.setDate(d.getDate() - 7);
    const min = new Date(el.min);
    if (d < min) d.setTime(min.getTime());
    el.value = d.toISOString().substring(0, 10);
    loadLbsSummary();
}

function histLbsNext7() {
    const el = document.getElementById('hist-lbs-date');
    const d = new Date(el.value);
    d.setDate(d.getDate() + 7);
    const max = new Date(el.max);
    if (d > max) d.setTime(max.getTime());
    el.value = d.toISOString().substring(0, 10);
    loadLbsSummary();
}

function loadLbsSummary() {
    const imei = document.getElementById('hist-device-sel').value;
    const endDate = document.getElementById('hist-lbs-date').value;
    if (!imei) return;

    document.getElementById('hist-loading').style.display = 'inline';
    document.getElementById('hist-summary-nodata').style.display = 'none';
    document.getElementById('hist-summary-table').style.display = 'none';
    document.getElementById('hist-summary-tbody').innerHTML = '';

    if (summaryStreamSource) { summaryStreamSource.close(); summaryStreamSource = null; }

    const url = `/Map/HistoryDailySummaryStream?imei=${encodeURIComponent(imei)}&endDate=${endDate}&type=Combined`;
    const es = new EventSource(url);
    summaryStreamSource = es;
    let hasData = false;

    es.onmessage = function(e) {
        const row = JSON.parse(e.data);
        if (row.done) {
            es.close(); summaryStreamSource = null;
            document.getElementById('hist-loading').style.display = 'none';
            if (!hasData) {
                document.getElementById('hist-summary-nodata').textContent = i18n.histNoData;
                document.getElementById('hist-summary-nodata').style.display = 'block';
            }
            return;
        }
        hasData = true;
        const tr = document.createElement('tr');
        tr.className = 'data-row';
        tr.innerHTML = `
            <td>${row.date}</td>
            <td>${row.firstGPS}</td>
            <td>${row.lastGPS}</td>
            <td>${row.duration}</td>
            <td>${row.recordCount}</td>
            <td>${row.totalKm}</td>
        `;
        if (row.recordCount > 0) {
            tr.onclick = () => loadLbsDetail(imei, row.date);
        } else {
            tr.style.color = '#94a3b8';
        }
        document.getElementById('hist-summary-tbody').appendChild(tr);
        document.getElementById('hist-summary-table').style.display = '';
    };

    es.onerror = function() {
        if (es.readyState === EventSource.CLOSED) return;
        es.close(); summaryStreamSource = null;
        document.getElementById('hist-loading').style.display = 'none';
        document.getElementById('hist-summary-nodata').textContent = i18n.histQueryFailed;
        document.getElementById('hist-summary-nodata').style.display = 'block';
    };
}

function loadLbsDetail(imei, date) {
    showHistDetailView(i18n.histDetailWithLbs.replace('{0}', imei).replace('{1}', date));
    clearHistoryMap();
    startHistoryStream(imei, date, 'Combined');
}

// -------- SSE streaming engine --------
function startHistoryStream(imei, date, type) {
    document.getElementById('hist-loading').style.display = 'inline';

    const url = `/Map/HistoryDataStream?imei=${encodeURIComponent(imei)}&date=${date}&type=${type}`;
    const es = new EventSource(url);
    historyStreamSource = es;
    let polylineColor = type === 'LBS' ? '#f59e0b' : '#ef4444';

    es.onmessage = function(e) {
        const msg = JSON.parse(e.data);
        if (msg.type === 'batch') {
            appendHistBatch(msg.logs, imei, type, polylineColor);
        } else if (msg.type === 'done') {
            es.close(); historyStreamSource = null;
            document.getElementById('hist-loading').style.display = 'none';
            if (msg.totalCount === 0) {
                document.getElementById('hist-detail-nodata').style.display = 'block';
                return;
            }
            document.getElementById('hist-detail-dist').textContent = msg.totalDistance;
            document.getElementById('hist-detail-maxspeed').textContent = msg.maxSpeed;
            document.getElementById('hist-detail-avgspeed').textContent = msg.avgSpeed;
            document.getElementById('hist-detail-count').textContent = msg.totalCount;
            finalizeHistoryMap();
        }
    };

    es.onerror = function() {
        if (es.readyState === EventSource.CLOSED) return;
        es.close(); historyStreamSource = null;
        document.getElementById('hist-loading').style.display = 'none';
        document.getElementById('hist-detail-nodata').textContent = i18n.histQueryFailed;
        document.getElementById('hist-detail-nodata').style.display = 'block';
    };
}

function appendHistBatch(logs, imei, type, polylineColor) {
    const tbody = document.getElementById('hist-detail-tbody');
    logs.forEach(l => {
        const effectiveLogType = l.logType || (type === 'LBS' ? 'L' : 'G');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${l.seq}</td>
            <td>${l.time}</td>
            <td>${l.lat.toFixed(6)},${l.lng.toFixed(6)}</td>
            <td>${l.gpsNo}</td>
            <td>${String(Math.round(l.hdop)).padStart(2,'0')}</td>
            <td>${csqBars(l.csq)} CSQ:${l.csq}</td>
            <td>${voltageCell(l.voltageV, l.voltage)}</td>
            <td>${i18n.unitMeterValue.replace('{0}', l.distanceM)}</td>
            <td>${i18n.unitKmhValue.replace('{0}', l.speed.toFixed(1))}</td>
            <td>${dirBadge(l.direction, effectiveLogType)}</td>
        `;
        tr.onclick = () => { if (map) { map.panTo({ lat: l.lat, lng: l.lng }); map.setZoom(17); } };
        tr.addEventListener('mouseenter', () => { tr.classList.add('row-hover'); highlightHistMarker(0, l, type, imei); });
        tr.addEventListener('mouseleave', () => { tr.classList.remove('row-hover'); restoreHistMarker(); });
        tbody.appendChild(tr);

        if (map) {
            const pos = { lat: l.lat, lng: l.lng };
            historyPolylinePath.push(pos);
            if (!historyPolyline) {
                historyPolyline = new google.maps.Polyline({
                    path: [pos], geodesic: true,
                    strokeColor: polylineColor, strokeOpacity: 0.8, strokeWeight: 3, map: map
                });
            } else {
                historyPolyline.getPath().push(new google.maps.LatLng(l.lat, l.lng));
            }
            const arrowMarker = new google.maps.Marker({
                position: pos, map: map,
                icon: makeHistPointIcon(l.direction, effectiveLogType),
                title: `${l.time} ${l.speed.toFixed(1)}km/h`
            });
            arrowMarker.addListener('click', () => { map.panTo(pos); map.setZoom(17); });
            historyArrowMarkers.push(arrowMarker);
            historyMarkers.push(arrowMarker);
        }
    });
    document.getElementById('hist-detail-table').style.display = '';
}

function finalizeHistoryMap() {
    if (!map || historyPolylinePath.length === 0) return;
    const path = historyPolylinePath;
    const startM = new google.maps.Marker({
        position: path[0], map: map, title: i18n.startPoint,
        label: { text: 'S', color: '#fff' },
        icon: { path: google.maps.SymbolPath.CIRCLE, scale: 9, fillColor: '#22c55e', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2 }
    });
    const endM = new google.maps.Marker({
        position: path[path.length - 1], map: map, title: i18n.endPoint,
        label: { text: 'E', color: '#fff' },
        icon: { path: google.maps.SymbolPath.CIRCLE, scale: 9, fillColor: '#ef4444', fillOpacity: 1, strokeColor: '#fff', strokeWeight: 2 }
    });
    historyMarkers.push(startM, endM);
    const bounds = new google.maps.LatLngBounds();
    path.forEach(p => bounds.extend(p));
    map.fitBounds(bounds);
}

// CSQ signal bars (0-31): render ▁▃▅▇ style Unicode bars
function csqBars(csq) {
    const pct = Math.min(csq / 31, 1);
    const filled = Math.round(pct * 4);
    const bars = ['▁','▃','▅','▇'];
    return '<span style="letter-spacing:-1px;color:#64748b">' +
        bars.map((b, i) => `<span style="color:${i < filled ? '#22c55e' : '#cbd5e1'}">${b}</span>`).join('') +
        '</span>';
}

// Voltage: render battery bar + raw voltage string (e.g. "4.14V")
function voltageBars(pct) {
    const fill = Math.max(0, Math.min(100, pct));
    const color = fill > 50 ? '#22c55e' : fill > 20 ? '#f59e0b' : '#ef4444';
    return `<span style="display:inline-block;width:18px;height:9px;border:1px solid #94a3b8;border-radius:2px;vertical-align:middle;position:relative;background:#e2e8f0">` +
        `<span style="display:block;width:${fill}%;height:100%;background:${color};border-radius:1px"></span>` +
        `</span>`;
}

function dirBadge(direction, logType) {
    if (logType === 'L') {
        return `<span style="display:inline-flex;align-items:center;gap:1px;background:#f59e0b;color:#fff;` +
            `border-radius:2px;padding:1px 4px;font-size:8px;white-space:nowrap">` +
            `<span style="font-size:10px;line-height:1">◉</span>LBS</span>`;
    }
    return `<span style="display:inline-flex;align-items:center;gap:1px;background:#2563eb;color:#fff;` +
        `border-radius:2px;padding:1px 4px;font-size:8px;white-space:nowrap">` +
        `<span style="display:inline-block;transform:rotate(${direction}deg);font-size:10px;line-height:1">↑</span>` +
        `GPS</span>`;
}

function voltageCell(voltageV, pct) {
    const bar = voltageBars(pct);
    const label = voltageV && voltageV !== '' ? voltageV : (pct > 0 ? pct + '%' : '—');
    return bar + ' ' + label;
}

// Highlight the arrow marker corresponding to hovered row
function highlightHistMarker(idx, l, type, imei) {
    restoreHistMarker();
    if (!map) return;
    const deviceMarker = Object.values(markers).find(m => m.markerData?.imei === imei);
    const iconFile = deviceMarker?.markerData?.iconFile || 'A';
    hoveredHistMarker = new google.maps.Marker({
        position: { lat: l.lat, lng: l.lng },
        map: map,
        zIndex: 9999,
        icon: makeIcon(l.direction, true, iconFile),
        title: `${l.time} ${l.speed !== undefined ? l.speed.toFixed(1) : ''}km/h`
    });
}

function restoreHistMarker() {
    if (hoveredHistMarker) { hoveredHistMarker.setMap(null); hoveredHistMarker = null; }
}

function makeHistPointIcon(direction, logType) {
    if (logType === 'L') {
        return {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 5,
            fillColor: '#f59e0b',
            fillOpacity: 0.9,
            strokeColor: '#fff',
            strokeWeight: 1.5
        };
    }
    return {
        path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
        scale: 3,
        rotation: direction,
        fillColor: '#2563eb',
        fillOpacity: 0.85,
        strokeColor: '#fff',
        strokeWeight: 1
    };
}


function clearHistoryMap() {
    if (summaryStreamSource) { summaryStreamSource.close(); summaryStreamSource = null; }
    if (historyStreamSource) { historyStreamSource.close(); historyStreamSource = null; }
    if (hoveredHistMarker) { hoveredHistMarker.setMap(null); hoveredHistMarker = null; }
    if (historyPolyline) { historyPolyline.setMap(null); historyPolyline = null; }
    historyMarkers.forEach(m => m.setMap(null));
    historyMarkers = [];
    historyArrowMarkers = [];
    historyPolylinePath = [];
}

// ========== INIT ==========
window.initMap = initMap;

function showMapLoadError(message) {
    const el = document.getElementById('no-map-msg');
    if (!el) return;
    el.style.display = 'block';
    const h5 = el.querySelector('h5');
    const p = el.querySelector('p');
    if (h5) h5.textContent = i18n.mapLoadErrorTitle;
    if (p) p.textContent = message;
    const loading = document.getElementById('loading-overlay');
    if (loading) loading.style.display = 'none';
}

window.gm_authFailure = function () {
    showMapLoadError(i18n.mapAuthFailed);
};

(function bindDeviceListDblClick() {
    const list = document.getElementById('device-list');
    if (!list) return;
    list.addEventListener('dblclick', function (e) {
        const item = e.target.closest('.device-item');
        if (!item) return;
        e.preventDefault();
        e.stopPropagation();
        const tbKey = parseInt(item.dataset.tbkey, 10);
        if (!isNaN(tbKey)) openDeviceSettings(tbKey);
    });
})();

initSidebarResize();
initHistPanelResize();
