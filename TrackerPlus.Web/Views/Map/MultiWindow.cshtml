@using System.Globalization
@{
    Layout = null;
    var keys = ViewBag.TbKeys as IList<int> ?? new List<int>();
    var cols = keys.Count switch
    {
        4 => 2,
        7 or 8 => 4,
        _ => keys.Count <= 3 ? keys.Count : 3
    };
    if (cols < 1) cols = 1;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <title>@L["Live_MultiWindow"]</title>
    <style>
        html, body { margin: 0; height: 100%; overflow: hidden; background: #0d1f30; }
        #grid {
            display: grid;
            grid-template-columns: repeat(@cols, 1fr);
            grid-template-rows: repeat(@((int)Math.Ceiling(keys.Count / (double)cols)), 1fr);
            width: 100vw; height: 100vh; gap: 2px;
        }
        #grid iframe { width: 100%; height: 100%; border: none; background: #fff; }
    </style>
</head>
<body>
<div id="grid">
    @foreach (var k in keys)
    {
        <iframe src="/Map/LivePane?tbKey=@k" title="@k"></iframe>
    }
</div>
</body>
</html>
