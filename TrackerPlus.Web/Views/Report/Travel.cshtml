@{
    Layout = null;
    var today = ViewBag.Today as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}
<form data-report-download="/Report/DownloadTravel">
    <input type="hidden" name="imei" value="" />

    <div class="mb-2 row">
        <label class="col-sm-4 col-form-label fw-semibold">@L["Report_StartDate"]</label>
        <div class="col-sm-8">
            <input type="date" class="form-control form-control-sm" name="date" value="@today" required />
        </div>
    </div>

    <div class="mb-2 row">
        <label class="col-sm-4 col-form-label fw-semibold">@L["Report_GpsStatus"]</label>
        <div class="col-sm-8 d-flex flex-column gap-1 justify-content-center">
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="gpsOnly" value="all" id="tr-gps-all" checked />
                <label class="form-check-label" for="tr-gps-all">@L["Report_AllGpsRecords"]</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="gpsOnly" value="gps" id="tr-gps-only" />
                <label class="form-check-label" for="tr-gps-only">@L["Report_GpsOnlyRecords"]</label>
            </div>
        </div>
    </div>

    <div class="mb-2 row">
        <label class="col-sm-4 col-form-label fw-semibold">@L["Report_SpeedUnit"]</label>
        <div class="col-sm-8 d-flex flex-column gap-1 justify-content-center">
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="speedUnit" value="km" id="tr-spd-km" checked />
                <label class="form-check-label" for="tr-spd-km">@L["Unit_Km"]</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="speedUnit" value="mi" id="tr-spd-mi" />
                <label class="form-check-label" for="tr-spd-mi">@L["Unit_Mile"]</label>
            </div>
        </div>
    </div>

    <div class="mb-2 row">
        <label class="col-sm-4 col-form-label fw-semibold">@L["Report_SpeedLimit"]</label>
        <div class="col-sm-8 d-flex flex-column gap-1 justify-content-center">
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="speedFilter" value="all" id="tr-sf-all" checked />
                <label class="form-check-label" for="tr-sf-all">@L["Report_SpeedAllData"]</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="speedFilter" value="idle" id="tr-sf-idle" />
                <label class="form-check-label" for="tr-sf-idle">@L["Report_SpeedIdleOnly"]</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="speedFilter" value="range" id="tr-sf-range" />
                <label class="form-check-label" for="tr-sf-range" style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">
                    @L["Report_SpeedRangePre"]
                    <input type="number" name="speedMin" value="0" min="0" max="999" style="width:58px"
                           class="form-control form-control-sm d-inline-block" id="tr-spd-min" />
                    ～
                    <input type="number" name="speedMax" value="999" min="0" max="999" style="width:58px"
                           class="form-control form-control-sm d-inline-block" id="tr-spd-max" />
                    @L["Report_SpeedRangePost"]
                </label>
            </div>
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-4 col-form-label fw-semibold">@L["Report_OutputMode"]</label>
        <div class="col-sm-8">
            <select name="format" class="form-select form-select-sm">
                <option value="csv">@L["Report_OutputCsv"]</option>
                <option value="xls">@L["Report_OutputXls"]</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="reset" class="btn btn-outline-secondary btn-sm">@L["Common_Reset"]</button>
        <button type="submit" class="btn btn-primary btn-sm">@L["Common_Ok"]</button>
    </div>
</form>
<script>
(function () {
    ['tr-spd-min', 'tr-spd-max'].forEach(function (id) {
        document.getElementById(id)?.addEventListener('focus', function () {
            document.getElementById('tr-sf-range').checked = true;
        });
    });
})();
</script>
