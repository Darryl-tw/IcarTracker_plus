@using System.Globalization
@inject Microsoft.Extensions.Options.IOptions<TrackerPlus.Core.Common.AdminAuthSettings> AdminAuthOptions
@{
    var adminAuth = AdminAuthOptions.Value;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["AdminTitle"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="adminNavMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Nav_Admin_Menu_Data"]</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Tracker" asp-action="Index">@L["Nav_Admin_Tracker_Home"]</a></li>
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Member" asp-action="Index">@L["Nav_Admin_Account_Mgmt"]</a></li>
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_OBM_Mgmt"]</span></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Nav_Admin_Menu_Firmware"]</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Firmware" asp-action="Index">@L["Nav_Admin_Firmware_Version"]</a></li>
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Firmware_UpdateLog"]</span></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Nav_Admin_Menu_Reports"]</a>
                    <ul class="dropdown-menu">
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Report_OrderStatus"]</span></li>
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Report_Account"]</span></li>
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Report_Pending"]</span></li>
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Report_AbnormalLogin"]</span></li>
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Report_Commission"]</span></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@L["Nav_Admin_Menu_Settings"]</a>
                    <ul class="dropdown-menu">
                        <li><span class="dropdown-item disabled">@L["Nav_Admin_Settings_System"]</span></li>
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="WebServiceIP" asp-action="Index">@L["Nav_Admin_Settings_IP"]</a></li>
                    </ul>
                </li>
            </ul>
            <ul class="navbar-nav align-items-center gap-2">
                <li class="nav-item"><partial name="_LanguageSwitcher" /></li>
                <li class="nav-item">
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link nav-link text-danger">@string.Format("{0}[{1}]", L["Nav_Logout"], ViewBag.AdminAccount ?? User.Identity?.Name)</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div class="container-fluid mt-3">
    @RenderBody()
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<form id="admin-idle-logout-form" asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
    <input type="hidden" name="reason" value="idle" />
</form>
<script>
    window.adminIdleConfig = {
        idleMs: @(adminAuth.IdleTimeoutMinutes * 60 * 1000),
        logoutUrl: '@Url.Action("Logout", "Account", new { area = "Admin" })'
    };
</script>
<script src="~/js/admin-idle.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
