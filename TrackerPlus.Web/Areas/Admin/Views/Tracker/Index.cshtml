    function btFmtDate(d) {
        const MM = ('0' + (d.getMonth() + 1)).slice(-2);
        const dd = ('0' + d.getDate()).slice(-2);
        return d.getFullYear() + '-' + MM + '-' + dd;
    }

    function btInitForm() {
        const today = new Date();
        document.querySelector('input[name="bt-reset"][value="N"]').checked = true;
        document.querySelector('input[name="bt-default-pay"][value="N"]').checked = true;
        document.querySelector('input[name="bt-sim"][value="Y"]').checked = true;
        document.getElementById('bt-add-sdate').value = btFmtDate(today);
        document.getElementById('bt-add-eds').value = '1';
        document.getElementById('bt-add-amount').value = '0';
        document.getElementById('bt-add-vaw').checked = false;
        document.getElementById('bt-add-memo').value = '';
        document.getElementById('bt-sub-id').value = '';
        document.getElementById('bt-sub-pw').value = '';
        btDefaultPayChange();
        btEdsCalcEdate();
    }

    window.btDefaultPayChange = function () {
        const on = document.querySelector('input[name="bt-default-pay"]:checked')?.value === 'Y';
        const panel = document.getElementById('bt-pay-panel');
        panel.style.opacity = on ? '1' : '.55';
        panel.style.pointerEvents = on ? 'auto' : 'none';
        if (on) {
            btSaleModeChange();
            btCalcOrderNo();
        }
    };

    window.btSaleModeChange = function () {
        const mode = document.getElementById('bt-add-model').value;
        const cfg = PL_EDS_ALLOWED[mode] || { allowed: ['12','24','36','13','6','1','0','S','A'], def: '12' };
        const edsEl = document.getElementById('bt-add-eds');
        const edateEl = document.getElementById('bt-add-edate');
        const amtEl = document.getElementById('bt-add-amount');
        const fmonthEl = document.getElementById('bt-add-fmonth');
        Array.from(edsEl.options).forEach(o => { o.disabled = cfg.allowed ? !cfg.allowed.includes(o.value) : true; });
        edsEl.disabled = !cfg.allowed;
        fmonthEl.style.display = 'none';
        if (cfg.refund) {
            edateEl.value = document.getElementById('bt-add-sdate').value;
            edateEl.readOnly = false;
            amtEl.value = '0'; amtEl.disabled = true;
        } else if (cfg.auto1900) {
            document.getElementById('bt-add-sdate').value = '1900-01-01';
            edateEl.value = '1900-01-01';
            edateEl.readOnly = true;
            if (cfg.amt0) { amtEl.value = '0'; amtEl.disabled = true; }
            else if (cfg.amt) { amtEl.value = cfg.amt; amtEl.disabled = !!cfg.amtDis; }
            else { amtEl.disabled = false; }
        } else {
            edateEl.readOnly = true;
            amtEl.disabled = false;
            if (cfg.setToday) document.getElementById('bt-add-sdate').value = btFmtDate(new Date());
            if (cfg.amt0) amtEl.value = '0';
            if (cfg.def) { edsEl.value = cfg.def; btEdsCalcEdate(); }
        }
        if (mode === '1') {
            const t = new Date();
            const yy = t.getFullYear().toString().slice(-2);
            const MM = ('0' + (t.getMonth() + 1)).slice(-2);
            const dd = ('0' + t.getDate()).slice(-2);
            document.getElementById('bt-add-orderno').value = 'C7B' + yy + MM + dd;
        } else btCalcOrderNo();
    };

    window.btEdsCalcEdate = function () {
        const eds = document.getElementById('bt-add-eds').value;
        const sdate = document.getElementById('bt-add-sdate').value;
        const fmonthEl = document.getElementById('bt-add-fmonth');
        const edateEl = document.getElementById('bt-add-edate');
        fmonthEl.style.display = eds === 'B' ? 'block' : 'none';
        if (!sdate || document.getElementById('bt-add-eds').disabled) return;
        const base = new Date(sdate);
        let edate = new Date(base);
        if (eds === 'S') edate = new Date('2070-01-01');
        else if (eds === 'A') {
            edateEl.readOnly = false;
            if (!edateEl.value || edateEl.readOnly === false) {
                const t = new Date(); t.setDate(t.getDate() + 1);
                edateEl.value = btFmtDate(t);
            }
            btCalcOrderNo();
            return;
        } else {
            edateEl.readOnly = true;
            if (eds === '0') edate.setDate(edate.getDate() + 7);
            else if (eds === 'B') edate.setMonth(edate.getMonth() + (parseInt(fmonthEl.value) || 1));
            else if (!isNaN(parseInt(eds))) edate.setMonth(edate.getMonth() + parseInt(eds));
        }
        edateEl.value = btFmtDate(edate);
        btCalcOrderNo();
    };

    window.btCalcEndFromStart = function () {
        const mode = document.getElementById('bt-add-model').value;
        if (mode !== '9') return;
        const s = document.getElementById('bt-add-sdate').value;
        if (!s) return;
        const d = new Date(s);
        d.setFullYear(d.getFullYear() + 1);
        document.getElementById('bt-add-edate').value = btFmtDate(d);
    };

    window.btCalcOrderNo = function () {
        const mode = document.getElementById('bt-add-model').value;
        const eds = document.getElementById('bt-add-eds').value;
        const today = new Date();
        const yy = today.getFullYear().toString().slice(-2);
        const MM = ('0' + (today.getMonth() + 1)).slice(-2);
        const dd = ('0' + today.getDate()).slice(-2);
        if (mode === '6') {
            document.getElementById('bt-add-orderno').value = 'BAK_' + today.getFullYear() + MM + dd;
            return;
        }
        const noSuffix = ['4','5','13','21','22'];
        const prefixMap = {
            '1':'C7','2':'A2','3':'A1','4':'B3F','5':'B2F','7':'Z8','13':'B4C','14':'B5','15':'B6','16':'A3',
            '17':'A4','18':'A6','20':'D6','21':'IS','22':'TRIAL','9':'A6'
        };
        const prefix = prefixMap[mode] || 'C7';
        const suffix = noSuffix.includes(mode) ? ''
            : ({'1':'B','8':'H','12':'C','24':'D','36':'E','B':'A','A':'G','0':'B','13':'C'}[eds] || 'C');
        document.getElementById('bt-add-orderno').value = prefix + suffix + yy + MM + dd;
    };

    async function loadBtDealerList() {
