    // ── 轉移歷史軌跡 ────────────────────────────────────────────────────
    window.doMoveHistory = async function () {
        const sourceImei = document.getElementById('mh-src').value.trim();
        const destImei = document.getElementById('mh-dest').value.trim();
        if (!sourceImei || sourceImei.length !== 15) { alert(_T.sourceImei15); return; }
        if (!destImei || destImei.length !== 15) { alert(_T.destImei15); return; }
        if (!(await TpDialog.confirm(_T.confirmMoveHistory.replace('{0}', sourceImei).replace('{1}', destImei)))) return;
        postJson('/Admin/Tracker/MoveHistory', { sourceImei, destImei })
            .then(r => { alert(r.message); if (r.success) bootstrap.Modal.getInstance(document.getElementById('moveHistoryModal'))?.hide(); });
    };

    // ── 新增裝置（對齊舊 IMEI_New）─────────────────────────────────────
    window.doAddTracker = async function () {
        const imeisText = (document.getElementById('add-imeis')?.value || '').trim();
        const subAdminId = (document.getElementById('add-sub-id')?.value || '').trim();
        const subAdminPassword = document.getElementById('add-sub-pw')?.value || '';
        if (!imeisText) { await TpDialog.alert(_T.enterImei); return; }
        if (!subAdminId || !subAdminPassword) { await TpDialog.alert(_T.subAdminRequired); return; }
        if (_admBusy) return;
        showAdmBusy(_T.batchBusy);
        try {
            const r = await postJson('/Admin/Tracker/CreateTracker', {
                imeis: imeisText.split(/\r?\n/),
                subAdminId,
                subAdminPassword
            });
            await finishAdmBusyThenAlert(r.message || (r.success ? _T.success : _T.failed), r.success ? _T.success : _T.failed);
            if (r.success) {
                bootstrap.Modal.getInstance(document.getElementById('addTrackerModal'))?.hide();
                document.getElementById('add-imeis').value = '';
                document.getElementById('add-sub-pw').value = '';
                window.doSearch();
            }
        } catch (err) {
            await finishAdmBusyThenAlert(_T.failed + (err && err.message ? '：' + err.message : ''), _T.failed);
        }
    };

    // ── 工具函式 ────────────────────────────────────────────────────────
    function getCheckedImeis() {
        return Array.from(document.querySelectorAll('#tracker-tbody tr.table-primary[data-tbkey]'))
            .map(tr => tr.cells[1]?.textContent?.trim() ?? '').filter(s => s.length === 15);
    }
    function getCheckedTbKeys() {
        return Array.from(document.querySelectorAll('#tracker-tbody tr.table-primary[data-tbkey]'))
            .map(tr => parseInt(tr.dataset.tbkey) || 0).filter(k => k > 0);
    }
    function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // 開啟 moveHistoryModal 時預填選取裝置的 IMEI
    document.getElementById('moveHistoryModal').addEventListener('show.bs.modal', () => {
        if (window._selImei) document.getElementById('mh-src').value = window._selImei;
    });
})();

// ── Resizable Splitters ───────────────────────────────────────────────────
(function () {
    const topPanel    = document.querySelector('.adm-top-panel');
    const bottomPanels = document.querySelector('.adm-bottom-panels');
    const leftPane    = document.getElementById('leftPane');
    const rightPane   = document.getElementById('rightPane');
    const vSplitter   = document.getElementById('vSplitter');
    const hSplitter   = document.getElementById('hSplitter');

    // Vertical splitter (top vs bottom)
    let vDrag = false, vStartY = 0, vStartH = 0;
    vSplitter.addEventListener('mousedown', e => {
        vDrag = true;
        vStartY = e.clientY;
        vStartH = topPanel.getBoundingClientRect().height;
        vSplitter.classList.add('dragging');
        document.body.style.userSelect = 'none';
        document.body.style.cursor = 'ns-resize';
        e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
        if (!vDrag) return;
        const pageH = document.querySelector('.adm-tracker-page').getBoundingClientRect().height;
        const newH = Math.max(80, Math.min(pageH - 80, vStartH + (e.clientY - vStartY)));
        topPanel.style.flex = 'none';
        topPanel.style.height = newH + 'px';
        bottomPanels.style.flex = '1';
    });
    document.addEventListener('mouseup', () => {
        if (!vDrag) return;
        vDrag = false;
        vSplitter.classList.remove('dragging');
        document.body.style.userSelect = '';
        document.body.style.cursor = '';
    });

    // Horizontal splitter (left vs right bottom pane)
    let hDrag = false, hStartX = 0, hStartW = 0;
    hSplitter.addEventListener('mousedown', e => {
        hDrag = true;
        hStartX = e.clientX;
        hStartW = leftPane.getBoundingClientRect().width;
        hSplitter.classList.add('dragging');
        document.body.style.userSelect = 'none';
        document.body.style.cursor = 'ew-resize';
        e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
        if (!hDrag) return;
        const totalW = bottomPanels.getBoundingClientRect().width;
        const newW = Math.max(120, Math.min(totalW - 120, hStartW + (e.clientX - hStartX)));
        leftPane.style.flex = 'none';
        leftPane.style.width = newW + 'px';
        rightPane.style.flex = '1';
        rightPane.style.width = '';
    });
    document.addEventListener('mouseup', () => {
        if (!hDrag) return;
        hDrag = false;
        hSplitter.classList.remove('dragging');
        document.body.style.userSelect = '';
        document.body.style.cursor = '';
    });
})();
</script>
