    // ── 訂單期限自動計算邏輯（對應舊系統 PayLog_New.aspx JS） ────────────
    // SaleModel → 允許的 EndDateStatus options + 預設值
    const PL_EDS_ALLOWED = {
        '1': { allowed: ['0','1'], def: '1' },                                    // 生產維修
        '2': { allowed: ['12','24'], def: '12' },                                 // 國內零售
        '3': { allowed: ['12','24'], def: '12' },                                 // 國內租貸
        '4': { allowed: null, def: null, auto1900: true, amt: '999999', amtDis: true }, // 國外經銷
        '5': { allowed: null, def: null, auto1900: true, amt0: true },            // 國外零售
        '6': { allowed: null, def: null, refund: true },                          // 到期退貨
        '7': { allowed: null, def: null, auto1900: true, amt0: true },            // 自動開通
        '13':{ allowed: ['12'], def: '12' },                                      // 國外續約
        '14':{ allowed: ['B'], def: 'B' },                                        // 國外贈送
        '15':{ allowed: ['0','1'], def: '1' },                                    // 國外銷售測試
        '16':{ allowed: ['8'], def: '8' },                                        // 國內經銷銷售
        '17':{ allowed: ['B'], def: 'B' },                                        // 國內經銷續約
        '18':{ allowed: ['0','1'], def: '1' },                                    // 國內銷售測試
        '20':{ allowed: ['12'], def: '12' },                                      // 內測訂單
        '21':{ allowed: ['8'], def: '8' },                                        // 國際sim卡
        '22':{ allowed: ['1'], def: '1', amt0: true, setToday: true }             // app tracker 試用單
    };

    window.plSaleModeChange = function plSaleModeChange() {
        const mode = document.getElementById('pl-add-model').value;
        const cfg  = PL_EDS_ALLOWED[mode] || { allowed: ['12','24','36','13','6','1','0','S','A'], def: '12' };
        const edsEl   = document.getElementById('pl-add-eds');
        const edateEl = document.getElementById('pl-add-edate');
        const amtEl   = document.getElementById('pl-add-amount');
        const fmonthEl= document.getElementById('pl-add-fmonth');

        // 啟用/禁用所有 options
        Array.from(edsEl.options).forEach(o => {
            o.disabled = cfg.allowed ? !cfg.allowed.includes(o.value) : true;
        });
        edsEl.disabled = !cfg.allowed;
        fmonthEl.style.display = 'none';

        if (cfg.refund) {
            edateEl.value  = document.getElementById('pl-add-sdate').value;
            edateEl.readOnly = false;
            amtEl.value = '0'; amtEl.disabled = true;
        } else if (cfg.auto1900) {
            document.getElementById('pl-add-sdate').value = '1900-01-01';
            edateEl.value = '1900-01-01';
            edateEl.readOnly = true;
            if (cfg.amt0)    { amtEl.value = '0'; amtEl.disabled = true; }
            else if (cfg.amt){ amtEl.value = cfg.amt; amtEl.disabled = !!cfg.amtDis; }
            else             { amtEl.disabled = false; }
        } else {
            edateEl.readOnly = true;
            amtEl.disabled = false;
            if (cfg.setToday) {
                const today = new Date();
                document.getElementById('pl-add-sdate').value = plFmtDate(today);
            }
            if (cfg.amt0) { amtEl.value = '0'; }
            if (cfg.def) { edsEl.value = cfg.def; plEdsCaclEdate(); }
        }

        plCalcOrderNo();
    }

    window.plEdsCaclEdate = function plEdsCaclEdate() {
        const eds   = document.getElementById('pl-add-eds').value;
        const sdate = document.getElementById('pl-add-sdate').value;
        const fmonthEl = document.getElementById('pl-add-fmonth');
        const edateEl  = document.getElementById('pl-add-edate');

        // 月數子選單顯示控制
        fmonthEl.style.display = eds === 'B' ? 'block' : 'none';

        if (!sdate || document.getElementById('pl-add-eds').disabled) return;

        const base = new Date(sdate);
        let edate = new Date(base);

        if (eds === 'S') {
            edateEl.value = '2070-01-01';
        } else if (eds === 'A') {
            edateEl.readOnly = false;
        } else if (eds === '0') {
            edate.setDate(edate.getDate() + 7);
            edateEl.readOnly = true;
            edateEl.value = plFmtDate(edate);
        } else if (eds === '8') {
            edate.setDate(edate.getDate() + 8);
            edateEl.readOnly = true;
            edateEl.value = plFmtDate(edate);
        } else if (eds === 'B') {
            const months = parseInt(fmonthEl.value) || 1;
            edate.setMonth(edate.getMonth() + months);
            edateEl.readOnly = true;
            edateEl.value = plFmtDate(edate);
        } else {
            const n = parseInt(eds);
            if (!isNaN(n)) { edate.setMonth(edate.getMonth() + n); }
            edateEl.readOnly = true;
            edateEl.value = plFmtDate(edate);
        }
        plCalcOrderNo();
    }

    window.plCalcOrderNo = function plCalcOrderNo() {
        const mode = document.getElementById('pl-add-model').value;
        const eds  = document.getElementById('pl-add-eds').value;
        const today = new Date();
        const yy = today.getFullYear().toString().slice(-2);
        const MM = ('0'+(today.getMonth()+1)).slice(-2);
        const dd = ('0'+today.getDate()).slice(-2);

        if (mode === '6') {
            document.getElementById('pl-add-orderno').value = 'BAK_' + today.getFullYear() + MM + dd;
            return;
        }
        // 純前綴（不加 EDS 後綴的銷售類型）
        const noSuffix = ['4','5','13','21','22'];
        const prefixMap = {
            '1':'C7','2':'A2','3':'A1','4':'B3F','5':'B2F',
            '7':'Z8','13':'B4C','14':'B5','15':'B6','16':'A3',
            '17':'A4','18':'A6','20':'D6','21':'IS','22':'TRIAL'
        };
        const prefix = prefixMap[mode] || 'C7';
        const suffix = noSuffix.includes(mode) ? ''
            : ({'1':'B','8':'H','12':'C','24':'D','36':'E','B':'A','A':'G','0':'B','13':'C'}[eds] || 'C');
        document.getElementById('pl-add-orderno').value = prefix + suffix + yy + MM + dd;
    }

    window.plFmtDate = function plFmtDate(d) {
        const MM = ('0'+(d.getMonth()+1)).slice(-2);
        const dd = ('0'+d.getDate()).slice(-2);
        return d.getFullYear() + '-' + MM + '-' + dd;
    }

    // ── 訂單管理：新增 ───────────────────────────────────────────────────
    window.cmdPayLogAdd = function () {
        if (!window._selImei) { alert(_T.plSelectDevice); return; }
        document.getElementById('pl-add-imei').value  = window._selImei;
        document.getElementById('pl-add-model').value = '1';
        document.getElementById('pl-add-memo').value  = '';
        document.getElementById('pl-add-vaw').checked = false;
        document.getElementById('pl-add-amount').value= '0';
        document.getElementById('pl-add-amount').disabled = false;
        document.getElementById('pl-add-eds').disabled = false;
        const today = new Date();
        document.getElementById('pl-add-sdate').value = plFmtDate(today);
        plSaleModeChange();
        showModal('paylogAddModal');
    };

    window.doPayLogAdd = function () {
        const edate = document.getElementById('pl-add-edate').value;
        const sdate = document.getElementById('pl-add-sdate').value;
        if (edate && sdate && edate < sdate) { alert(_T.plEdateBeforeSdate); return; }
        const req = {
            imei        : document.getElementById('pl-add-imei').value.trim(),
            orderNo     : document.getElementById('pl-add-orderno').value.trim(),
            amount      : parseFloat(document.getElementById('pl-add-amount').value) || 0,
            saleModel   : parseInt(document.getElementById('pl-add-model').value) || 1,
            sDate       : sdate || null,
            eDate       : edate || null,
            memo        : document.getElementById('pl-add-memo').value.trim(),
            valueAddedWeb: document.getElementById('pl-add-vaw').checked ? 1 : 0
        };
        postJson('/Admin/PayLog/CreateJson', req).then(r => {
            alert(r.message);
            if (r.success) { bootstrap.Modal.getInstance(document.getElementById('paylogAddModal'))?.hide(); loadPayLogs(window._selImei); }
        });
    };

    // ── 訂單管理：修改 ───────────────────────────────────────────────────
    window.cmdPayLogEdit = function () {
        if (!requirePayLogSelection()) return;
        fetch('/Admin/PayLog/GetJson?id=' + _selPlTbKey).then(r => r.json()).then(d => {
            if (!d.success) { alert(d.message); return; }
            document.getElementById('pl-edit-tbkey').value  = d.tbKey;
            document.getElementById('pl-edit-orderno').value= d.orderNo ?? '';
            document.getElementById('pl-edit-amount').value = d.amount;
            document.getElementById('pl-edit-model').value  = d.saleModel;
            document.getElementById('pl-edit-sdate').value  = d.sDate ?? '';
            document.getElementById('pl-edit-edate').value  = d.eDate ?? '';
            document.getElementById('pl-edit-memo').value   = d.memo ?? '';
            document.getElementById('pl-edit-vaw').checked  = d.valueAddedWeb === 1;
            showModal('paylogEditModal');
        });
    };

    window.doPayLogEdit = function () {
        const req = {
            tbKey       : parseInt(document.getElementById('pl-edit-tbkey').value),
            orderNo     : document.getElementById('pl-edit-orderno').value.trim(),
            amount      : parseFloat(document.getElementById('pl-edit-amount').value) || 0,
            saleModel   : parseInt(document.getElementById('pl-edit-model').value) || 1,
            sDate       : document.getElementById('pl-edit-sdate').value || null,
            eDate       : document.getElementById('pl-edit-edate').value || null,
            memo        : document.getElementById('pl-edit-memo').value.trim(),
            valueAddedWeb: document.getElementById('pl-edit-vaw').checked ? 1 : 0
        };
        postJson('/Admin/PayLog/UpdateJson', req).then(r => {
            alert(r.message);
            if (r.success) { bootstrap.Modal.getInstance(document.getElementById('paylogEditModal'))?.hide(); loadPayLogs(window._selImei); }
