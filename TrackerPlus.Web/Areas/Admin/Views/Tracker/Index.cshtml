    window.doBatchTransfer = async function () {
        const raw = document.getElementById('bt-imeis').value;
        const imeis = raw.split(/[\n,\r]+/).map(s => s.trim()).filter(s => s.length === 15);
        const obmTbKey = parseInt(document.getElementById('bt-obm').value) || 0;
        const defaultPay = document.querySelector('input[name="bt-default-pay"]:checked')?.value === 'Y';
        const resetOnline = document.querySelector('input[name="bt-reset"]:checked')?.value === 'Y';
        if (!imeis.length) { alert(_T.enterImei); return; }
        if (!obmTbKey) { alert(_T.selectTargetObm); return; }
        const subAdminId = document.getElementById('bt-sub-id').value.trim();
        const subAdminPassword = document.getElementById('bt-sub-pw').value;
        if (!subAdminId || !subAdminPassword) { alert(_T.subAdminRequired); return; }
        const iconChecked = document.querySelector('input[name="bt-icon"]:checked');
        const isSimBundled = document.querySelector('input[name="bt-sim"]:checked')?.value === 'Y';
        const saleModel = parseInt(document.getElementById('bt-add-model').value) || 0;
        const sdate = document.getElementById('bt-add-sdate').value;
        const edate = document.getElementById('bt-add-edate').value;
        const amount = parseFloat(document.getElementById('bt-add-amount').value) || 0;
        const endDateStatus = document.getElementById('bt-add-eds').value;
        if (defaultPay) {
            if (!saleModel) { alert(_T.plSelectSaleModel || '請選擇銷售類型'); return; }
            if (edate && sdate && edate < sdate) { alert(_T.plEdateBeforeSdate); return; }
            const skipAmt = ['1','6','22'].includes(String(saleModel));
            if (!skipAmt && amount <= 0) { alert(_T.plAmountRequired || '金額不得小於 1'); return; }
            const orderNo = document.getElementById('bt-add-orderno').value.trim();
            if (!orderNo && saleModel !== 6) { alert(_T.plOrderNoRequired || '訂單號碼不得為空'); return; }
            if (endDateStatus === 'A' && !edate) { alert(_T.plEdateBeforeSdate); return; }
        }
        if (!(await TpDialog.confirm(_T.confirmBatchTransfer.replace('{0}', imeis.length)))) return;
        if (_admBusy) return;
        const req = {
            imeis, obmTbKey, resetOnlineTime: resetOnline, defaultPay,
            orderNo: document.getElementById('bt-add-orderno').value.trim(),
            saleModel, sDate: sdate || null, eDate: edate || null,
            endDateStatus,
            fMonth: parseInt(document.getElementById('bt-add-fmonth').value) || 1,
            amount,
            valueAddedWeb: document.getElementById('bt-add-vaw').checked ? 1 : 0,
            saleMemo: document.getElementById('bt-add-memo').value.trim(),
            isSimBundled,
            iconFile: iconChecked ? iconChecked.value : '',
            subAdminId,
            subAdminPassword
        };
        showAdmBusy(_T.batchBusy);
        try {
            const r = await postJson('/Admin/Tracker/BatchTransfer', req);
            await finishAdmBusyThenAlert(r.message, r.success ? _T.success : _T.failed);
            if (r.success) {
                if (typeof StaticModal !== 'undefined') StaticModal.hide('batchTransferModal');
                else bootstrap.Modal.getInstance(document.getElementById('batchTransferModal'))?.hide();
                window.doSearch();
            }
        } catch (err) {
            await finishAdmBusyThenAlert(_T.failed + (err && err.message ? '：' + err.message : ''), _T.failed);
        }
    };

