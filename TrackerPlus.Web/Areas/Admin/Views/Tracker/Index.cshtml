@{
    ViewData["Title"] = L["Admin_Tracker_Title"].Value;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form id="af-form" style="display:none">@Html.AntiForgeryToken()</form>

<div class="adm-tracker-page">
    <!-- ===== Top Panel: Device Grid ===== -->
    <div class="adm-top-panel">
        <!-- Function Toolbar -->
        <div class="adm-panel-hdr" style="background:#e9f0fb;border-bottom:1px solid #c5d5ea;flex-wrap:wrap">
            <button class="btn btn-success btn-adm" onclick="showModal('addTrackerModal')" title="@L["Admin_Tracker_BtnAddTitle"]">@L["Admin_Tracker_BtnAdd"]</button>
            <button class="btn btn-danger btn-adm" onclick="cmdDelete()" title="@L["Admin_Tracker_BtnDeleteTitle"]">@L["Common_Delete"]</button>
            <button class="btn btn-warning btn-adm" onclick="showModal('clearHistoryModal')" title="@L["Admin_Tracker_BtnClearHistory"]">@L["Admin_Tracker_BtnClearHistory"]</button>
            <button class="btn btn-secondary btn-adm" onclick="openBatchTransfer()" title="@L["Admin_Tracker_BtnBatchTransferTitle"]">@L["Admin_Tracker_BtnBatchTransfer"]</button>
            <button class="btn btn-info btn-adm text-white" onclick="openFwUpgrade()" title="@L["Admin_Tracker_BtnFwUpgrade"]">@L["Admin_Tracker_BtnFwUpgrade"]</button>
            <button class="btn btn-dark btn-adm" onclick="cmdBatchDelete()" title="@L["Admin_Tracker_BtnBatchDeleteTitle"]">@L["Admin_Tracker_BtnBatchDelete"]</button>
            <button class="btn btn-outline-primary btn-adm" onclick="cmdFrontend()" title="@L["Admin_Tracker_BtnFrontendSingle"]">@L["Admin_Tracker_BtnFrontendSingle"]</button>
            <button class="btn btn-outline-danger btn-adm" onclick="showModal('factoryResetModal')" title="@L["Admin_Tracker_BtnFactoryResetTitle"]">@L["Admin_Tracker_BtnFactoryReset"]</button>
            <button class="btn btn-outline-secondary btn-adm" onclick="showModal('moveHistoryModal')" title="@L["Admin_Tracker_BtnMoveHistory"]">@L["Admin_Tracker_BtnMoveHistory"]</button>
        </div>
        <!-- Search / Filter bar -->
        <div class="adm-panel-hdr" style="flex-wrap:wrap;gap:6px">
            <span class="adm-panel-title">@L["Admin_Tracker_Title"]</span>
            <span id="total-info" class="badge bg-secondary ms-1" style="font-size:.75rem"></span>
            <div class="adm-ctrl-row ms-2">
                <label class="adm-filter-item">
                    <span class="text-muted">@L["Admin_Tracker_Col_OBM"]</span>
                    <input type="text" id="kw-obm" class="form-control form-control-sm" style="width:100px"
                           onkeydown="if(event.key==='Enter')doSearch()" />
                </label>
                <label class="adm-filter-item">
                    <span class="text-muted">IMEI</span>
                    <input type="text" id="kw-imei" class="form-control form-control-sm" style="width:160px"
                           onkeydown="if(event.key==='Enter')doSearch()" />
                </label>
                <label class="adm-filter-item">
                    <span class="text-muted">@L["Admin_Tracker_Col_Account"]</span>
                    <input type="text" id="kw-account" class="form-control form-control-sm" style="width:180px"
                           placeholder="ID / Email" autocomplete="off" onkeydown="if(event.key==='Enter')doSearch()" />
                </label>
                <button type="button" onclick="doSearch()" class="btn btn-primary btn-sm">@L["Common_Search"]</button>
            </div>
            <!-- Pagination -->
            <div class="adm-ctrl-row ms-auto">
                <span class="text-muted" style="font-size:.8rem">@L["Common_PerPage"]</span>
                <select id="pg-size" class="form-select form-select-sm" style="width:68px" onchange="doSearch()">
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>
                <button class="btn btn-outline-secondary btn-sm px-2" onclick="goFirst()" title="@L["Common_PreviousPage"]">|◀</button>
                <button class="btn btn-outline-secondary btn-sm px-2" onclick="goPrev()"  title="@L["Common_PreviousPage"]">◀</button>
                <span id="pg-info" style="white-space:nowrap;font-size:.83rem">- / -</span>
                <button class="btn btn-outline-secondary btn-sm px-2" onclick="goNext()"  title="@L["Common_NextPage"]">▶</button>
                <button class="btn btn-outline-secondary btn-sm px-2" onclick="goLast()" title="@L["Common_NextPage"]">▶|</button>
                <span class="text-muted" style="font-size:.8rem">@L["Common_JumpTo"]</span>
                <input type="number" id="pg-jump" class="form-control form-control-sm" style="width:56px"
                       min="1" value="1" onkeydown="if(event.key==='Enter')doJump()" />
                <button class="btn btn-outline-secondary btn-sm" onclick="doJump()">Go</button>
            </div>
        </div>
        <!-- Table -->
        <div class="adm-table-area">
            <div id="loading-overlay">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <table class="table table-striped table-sm table-hover mb-0 adm-grid-table" data-grid-sort="off">
                <thead class="table-dark adm-sticky-head">
                    <tr id="tracker-sort-head">
                        <th class="sortable" data-sort="obm" style="min-width:80px;white-space:nowrap">@L["Admin_Tracker_Col_OBM"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="imei" style="min-width:140px;white-space:nowrap">IMEI<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="cname" style="min-width:110px;white-space:nowrap">@L["Admin_Tracker_Col_Name"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="bindCount" style="min-width:65px;white-space:nowrap">@L["Admin_Tracker_Col_BindCount"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="createDate" style="min-width:82px;white-space:nowrap">@L["Admin_Tracker_Col_CreateDate"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="serviceEndDate" style="min-width:82px;white-space:nowrap">@L["Admin_Tracker_Col_ServiceEnd"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="account" style="min-width:110px;white-space:nowrap">@L["Admin_Tracker_Col_Account"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="currentStatus" style="min-width:80px;white-space:nowrap">@L["Admin_Tracker_Col_CurrentStatus"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="firmware" style="min-width:110px;white-space:nowrap">@L["Admin_Tracker_Col_Firmware"]<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="iccid" style="min-width:90px;white-space:nowrap">ICCID<span class="sort-ind"></span></th>
                        <th class="sortable" data-sort="apn" style="min-width:70px;white-space:nowrap">APN<span class="sort-ind"></span></th>
                    </tr>
                    <tr id="filter-row">
                        <th><input type="search" id="f-obm"     class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                        <th><input type="search" id="f-imei"    class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                        <th><input type="search" id="f-cname"   class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                        <th class="text-center p-0" style="vertical-align:middle">
                          <button type="button" class="btn btn-link btn-sm py-0 px-1 text-muted" id="btn-clear-col-filters" title="@L["Common_Reset"]" style="font-size:.65rem;line-height:1">×</button>
                        </th>
                        <th></th>
                        <th></th>
                        <th><input type="search" id="f-account" class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                        <th>
                            <select id="f-cur-status" class="col-filter-sel">
                                <option value="">@L["Admin_Tracker_AllStatus"]</option>
                                <option value="online">@L["Admin_Tracker_Status_Online"]</option>
                                <option value="sleep">@L["Admin_Tracker_Status_Offline"]</option>
                                <option value="disconnected">@L["Admin_Tracker_Status_Disconnected"]</option>
                            </select>
                        </th>
                        <th><input type="search" id="f-firmware" class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                        <th><input type="search" id="f-iccid"   class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                        <th><input type="search" id="f-apn"     class="col-filter" placeholder="@L["Admin_Tracker_FilterPh"]" autocomplete="off" autocapitalize="off" spellcheck="false" readonly tabindex="-1" data-lpignore="true" data-form-type="other" /></th>
                    </tr>
                </thead>
                <tbody id="tracker-tbody">
                    <tr><td colspan="11" class="text-center text-muted py-3" style="font-size:.85rem">@L["Admin_Tracker_NoData"]</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===== Vertical Splitter ===== -->
    <div class="adm-v-splitter" id="vSplitter"></div>

    <!-- ===== Bottom Panels ===== -->
    <div class="adm-bottom-panels">
        <!-- Left: Member Tracker List -->
        <div class="adm-bottom-pane" id="leftPane">
            <div class="adm-panel-hdr">
                <div style="display:flex;align-items:center;gap:6px">
                    <span class="adm-panel-title">@L["Admin_Tracker_SubTitle_DeviceList"]</span>
                    <span id="member-info" class="text-muted" style="font-size:.8rem"></span>
                </div>
                <div class="d-flex gap-1 mt-1">
                    <button class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdUnbindAll()" title="@L["Admin_Tracker_BtnUnbindAllTitle"]">@L["Admin_Tracker_BtnUnbindAll"]</button>
                    <button class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdUnbind()" title="@L["Admin_Tracker_BtnUnbindTitle"]">@L["Admin_Tracker_BtnUnbind"]</button>
                    <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdFrontend()" title="@L["Admin_Tracker_BtnFrontendTitle"]">@L["Admin_Tracker_BtnFrontend"]</button>
                </div>
            </div>
            <div class="adm-pane-body">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-secondary adm-sticky-head" style="font-size:.78rem">
                        <tr>
                            <th style="white-space:nowrap">IMEI</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_Name"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_CreateDate"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_ServiceEnd"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_LastReportTime"]</th>
                            <th style="white-space:nowrap">@L["Common_Status"]</th>
                        </tr>
                    </thead>
                    <tbody id="member-tbody">
                        <tr><td colspan="6" class="text-center text-muted py-3" style="font-size:.85rem">@L["Admin_Tracker_NoSelection"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Horizontal Splitter -->
        <div class="adm-h-splitter" id="hSplitter"></div>
        <!-- Right: PayLog -->
        <div class="adm-bottom-pane" id="rightPane">
            <div class="adm-panel-hdr">
                <div style="display:flex;align-items:center;gap:6px">
                    <span class="adm-panel-title">@L["Admin_Tracker_SubTitle_Orders"]</span>
                    <span id="paylog-info" class="text-muted" style="font-size:.8rem"></span>
                </div>
                <div class="d-flex gap-1 mt-1">
                    <button class="btn btn-success btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdPayLogAdd()" title="@L["Admin_PayLog_BtnAddTitle"]">@L["Admin_PayLog_BtnAdd"]</button>
                    <button class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdPayLogEdit()" title="@L["Admin_PayLog_BtnEditTitle"]">@L["Admin_PayLog_BtnEdit"]</button>
                    <button class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdPayLogDelete()" title="@L["Admin_PayLog_BtnDeleteTitle"]">@L["Admin_PayLog_BtnDelete"]</button>
                    <button class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:.75rem" onclick="cmdPayLogMove()" title="@L["Admin_PayLog_BtnMoveTitle"]">@L["Admin_PayLog_BtnMove"]</button>
                </div>
            </div>
            <div class="adm-pane-body">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-secondary adm-sticky-head" style="font-size:.78rem">
                        <tr>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_CreateDate"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_OrderNo"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_SaleMemo"]</th>
                            <th style="white-space:nowrap">@L["Admin_PayLog_Operator"]</th>
                            <th style="white-space:nowrap">@L["Admin_PayLog_SaleModel"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_ValueAdded"]</th>
                            <th style="white-space:nowrap">@L["Admin_PayLog_Amount"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_StartDate"]</th>
                            <th style="white-space:nowrap">@L["Admin_Tracker_Col_EndDate"]</th>
                        </tr>
                    </thead>
                    <tbody id="paylog-tbody">
                        <tr><td colspan="9" class="text-center text-muted py-3" style="font-size:.85rem">@L["Admin_Tracker_NoSelection"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===== Edit Tracker Modal ===== -->
<div class="modal fade" id="trackerEditModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2 bg-light">
        <h6 class="modal-title mb-0">修改定位器資料 — <code id="em-imei-hdr"></code></h6>
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0" style="position:relative">
        <div id="em-loading" style="display:none;position:absolute;inset:0;z-index:9;background:rgba(255,255,255,.85);align-items:center;justify-content:center">
          <div class="spinner-border text-primary"></div>
        </div>
        <ul class="nav nav-tabs px-3 pt-2" role="tablist">
          <li class="nav-item"><button class="nav-link active px-3 py-1" data-bs-toggle="tab" data-bs-target="#etab-device"   type="button">裝置資料</button></li>
          <li class="nav-item"><button class="nav-link px-3 py-1"        data-bs-toggle="tab" data-bs-target="#etab-settings" type="button">裝置設定</button></li>
          <li class="nav-item"><button class="nav-link px-3 py-1"        data-bs-toggle="tab" data-bs-target="#etab-alert"    type="button">警報設定</button></li>
          <li class="nav-item"><button class="nav-link px-3 py-1"        data-bs-toggle="tab" data-bs-target="#etab-orders"   type="button">訂單期限</button></li>
        </ul>
        <div class="tab-content border border-top-0 mx-3 mb-2 rounded-bottom" style="min-height:360px">

          <!-- Tab 1: 裝置資料 -->
          <div class="tab-pane fade show active p-3" id="etab-device">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="mb-2">
                  <label class="form-label small fw-semibold mb-0">IMEI</label>
                  <div id="em-imei-val" class="form-control-plaintext fw-bold ps-1" style="font-size:.85rem;line-height:2"></div>
                </div>
                <div class="mb-2">
                  <label class="form-label small mb-1" for="em-cname">識別名稱</label>
                  <input type="text" id="em-cname" class="form-control form-control-sm" />
                </div>
              </div>
              <div class="col-md-6" id="em-udfields-col">
                <!-- UdFields rendered dynamically -->
              </div>
            </div>
            <div id="em-labels-row" class="mb-2"></div>
            <hr class="my-2" />
            <div class="mb-2">
              <label class="form-label small fw-semibold mb-2">@L["Admin_Tracker_MapIcon"]</label>
              <table class="table table-sm table-borderless mb-0 bt-map-icon-grid">
                <tbody>
                  <tr>
                    @foreach (var ic in new[] {
                      ("A", L["DeviceIcon_A"].Value),
                      ("B", L["DeviceIcon_B"].Value),
                      ("C", L["DeviceIcon_C"].Value),
                      ("D", L["DeviceIcon_D"].Value),
                      ("E", L["DeviceIcon_E"].Value),
                      ("F", L["DeviceIcon_F"].Value),
                      ("G", L["DeviceIcon_G"].Value),
                      ("H", L["DeviceIcon_H"].Value)
                    }) {
                      <td class="text-center">
                        <img src="@Url.Content($"~/images/map-icons/Icon{ic.Item1}/dir_0.png")" alt="@ic.Item2" class="bt-map-icon-img" />
                      </td>
                    }
                  </tr>
                  <tr>
                    @foreach (var ic in new[] { "A", "B", "C", "D", "E", "F", "G", "H" }) {
                      <td class="text-center">
                        <input class="form-check-input" type="radio" name="em-icon" id="em-icon-@ic" value="@ic">
                      </td>
                    }
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Tab 2: 裝置設定 -->
          <div class="tab-pane fade p-3" id="etab-settings">
            <div class="row g-3">
              <div class="col-md-5">
                <label class="form-label small fw-semibold mb-1">緊急通報號碼</label>
                <input type="text" id="em-sos1" class="form-control form-control-sm" placeholder="+886..." />
              </div>
              <div class="col-md-7">
                <div class="row g-2">
                  <div class="col-12">
                    <label class="form-label small mb-1">定位回報時間</label>
                    <div class="input-group input-group-sm">
                      <input type="number" id="em-gps-time" class="form-control" min="1" max="7200" />
                      <span class="input-group-text" style="font-size:.78rem">秒（1~7200）</span>
                    </div>
                  </div>
                  <div class="col-12">
                    <label class="form-label small mb-1">密碼</label>
                    <input type="text" id="em-password" class="form-control form-control-sm" readonly />
                  </div>
                </div>
                <hr class="my-2" />
                <div class="small fw-semibold mb-2">震動器設定</div>
                <div class="row g-2">
                  <div class="col-6">
                    <label class="form-label small mb-1">車型</label>
                    <select id="em-shock-mode" class="form-select form-select-sm">
                      <option value="1">汽車</option>
                      <option value="2">機車</option>
                    </select>
                  </div>
                  <div class="col-6">
                    <label class="form-label small mb-1">震動器靈敏度</label>
                    <select id="em-shock-sens" class="form-select form-select-sm">
                      @for (int i = -4, n = 1; i <= 4; i++, n++)
                      {
                          var label = i > 0 ? $"+{i}" : i.ToString();
                          <option value="@n">@label</option>
                      }
                    </select>
                  </div>
                  <div class="col-12">
                    <label class="form-label small mb-1">是否開啟（省電模式）</label>
                    <select id="em-power-saving" class="form-select form-select-sm" style="width:120px">
                      <option value="N">關閉</option>
                      <option value="Y">開啟</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab 3: 警報設定 -->
          <div class="tab-pane fade p-3" id="etab-alert">
            <div class="mb-3">
              <div class="small fw-semibold mb-1">急速逾時模組</div>
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="small">當急速超過</span>
                <select id="em-ap-minute" class="form-select form-select-sm" style="width:80px">
                  <option value="0">關閉</option>
                  <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                  <option value="5">5</option><option value="10">10</option><option value="15">15</option>
                  <option value="20">20</option><option value="30">30</option><option value="60">60</option>
                </select>
                <span class="small">分鐘時，回報所在座標。</span>
              </div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="small" style="white-space:nowrap">自定訊息內容:</span>
                <input type="text" id="em-ap-msg" class="form-control form-control-sm" />
              </div>
            </div>
            <div class="mb-3">
              <div class="small fw-semibold mb-1">超速偵測模組</div>
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="small">當時速超過</span>
                <select id="em-as-minute" class="form-select form-select-sm" style="width:80px">
                  <option value="0">關閉</option>
                  <option value="30">30</option><option value="40">40</option><option value="50">50</option>
                  <option value="60">60</option><option value="70">70</option><option value="80">80</option>
                  <option value="90">90</option><option value="100">100</option><option value="110">110</option>
                  <option value="120">120</option>
                </select>
                <span class="small">公里/小時，發出警報訊息。</span>
              </div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="small" style="white-space:nowrap">自定訊息內容:</span>
                <input type="text" id="em-as-msg" class="form-control form-control-sm" />
              </div>
            </div>
            <hr class="my-2" />
            <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
              <div class="d-flex align-items-center gap-2">
                <label class="form-label small mb-0">分享密碼（4碼）</label>
                <input type="text" id="em-share-pwd" class="form-control form-control-sm" maxlength="4" style="width:70px" />
              </div>
              <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="em-share-enabled">
                <label class="form-check-label small" for="em-share-enabled">開啟分享功能</label>
              </div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <label class="form-label small mb-0">警報模式</label>
              <select id="em-alert-mode" class="form-select form-select-sm" style="width:110px">
                <option value="0">持續</option>
                <option value="1">單次</option>
              </select>
            </div>
          </div>

          <!-- Tab 4: 訂單期限 -->
          <div class="tab-pane fade" id="etab-orders">
            <div class="d-flex gap-2 align-items-center p-2 border-bottom" style="background:#f8f9fa">
