@model TrackerPlus.Core.Models.Member
@{
    ViewData["Title"] = L["Admin_Member_Detail"].Value + " - " + Model.ID;
}
<div class="d-flex justify-content-between mb-3">
    <h2>@L["Admin_Member_Detail"]</h2>
    <a asp-action="Index" asp-area="Admin" class="btn btn-secondary btn-with-icon">@Html.UiIcon("back")<span>@L["Common_Back"]</span></a>
</div>
<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">@L["Admin_Member_AccountInfo"]</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">TbKey</dt><dd class="col-sm-8">@Model.TbKey</dd>
                    <dt class="col-sm-4">@L["Admin_Member_Account"]</dt><dd class="col-sm-8">@Model.ID</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">@L["Common_Status"]</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.MemberStatus == "Y" ? "bg-success" : Model.MemberStatus == "D" ? "bg-danger" : "bg-secondary")">@Model.MemberStatus</span>
                    </dd>
                    <dt class="col-sm-4">OBM</dt><dd class="col-sm-8">@Model.OBM_TbKey</dd>
                    <dt class="col-sm-4">@L["Field_CreatedDate"]</dt><dd class="col-sm-8">@Model.CDate.ToString("yyyy-MM-dd")</dd>
                </dl>
                <div class="btn-group mt-2">
                    @foreach (var s in new[] { ("Y", L["Admin_Member_SetActive"].Value, "btn-success"), ("D", L["Admin_Member_SetDisabled"].Value, "btn-danger"), ("S", L["Admin_Member_SetPaused"].Value, "btn-warning") })
                    {
                        if (Model.MemberStatus != s.Item1)
                        {
                            <form asp-action="SetStatus" asp-area="Admin" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.TbKey" />
                                <input type="hidden" name="status" value="@s.Item1" />
                                <button type="submit" class="btn btn-sm @s.Item3">@s.Item2</button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header bg-success text-white">@L["Admin_Member_EditProfile"]</div>
            <div class="card-body">
                <form asp-action="Update" asp-area="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TbKey" value="@Model.TbKey" />
                    <input type="hidden" name="ID" value="@Model.ID" />
                    <input type="hidden" name="Password" value="@Model.Password" />
                    <input type="hidden" name="MemberStatus" value="@Model.MemberStatus" />
                    <input type="hidden" name="OBM_TbKey" value="@Model.OBM_TbKey" />
                    <input type="hidden" name="CDate" value="@Model.CDate" />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">@L["Admin_Member_Name"]</label>
                            <input type="text" name="CName" value="@Model.CName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Admin_Member_Phone"]</label>
                            <input type="text" name="Tel" value="@Model.Tel" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Field_Language"]</label>
                            <select name="UserLanguage" class="form-select">
                                <option value="CHT" selected="@(Model.UserLanguage == "CHT")">@L["Lang_CHT"]</option>
                                <option value="CHS" selected="@(Model.UserLanguage == "CHS")">@L["Lang_CHS"]</option>
                                <option value="ENG" selected="@(Model.UserLanguage == "ENG")">@L["Lang_ENG"]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Admin_Member_Unit"]</label>
                            <select name="UserUnit" class="form-select">
                                <option value="K" selected="@(Model.UserUnit == "K")">@L["Unit_Km"]</option>
                                <option value="M" selected="@(Model.UserUnit == "M")">@L["Unit_Mile"]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Admin_Member_Timezone"]</label>
                            <input type="number" name="Timezoom" value="@Model.Timezoom" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Admin_Member_Address"]</label>
                            <input type="text" name="Addr" value="@Model.Addr" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center gap-3">
                            <div class="form-check">
                                <input type="checkbox" name="IsSendEmail" value="true" class="form-check-input" checked="@Model.IsSendEmail" />
                                <label class="form-check-label">@L["Admin_Member_SendEmail"]</label>
                                @if (!Model.IsSendEmail) { <input type="hidden" name="IsSendEmail" value="false" /> }
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsPush" value="true" class="form-check-input" checked="@Model.IsPush" />
                                <label class="form-check-label">@L["Admin_Member_Push"]</label>
                                @if (!Model.IsPush) { <input type="hidden" name="IsPush" value="false" /> }
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success mt-3 btn-with-icon">@Html.UiIcon("save")<span>@L["Common_Save"]</span></button>
                </form>
            </div>
        </div>
    </div>
</div>
