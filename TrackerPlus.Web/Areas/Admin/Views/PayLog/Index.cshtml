@using TrackerPlus.Core.Common
@model PagedResult<TrackerPlus.Core.Models.PayLog>
@{
    ViewData["Title"] = L["Admin_PayLog_Title"].Value;
    var filter = ViewBag.Filter as QueryFilter ?? new QueryFilter();
}
<div class="d-flex justify-content-between mb-3">
    <h2>@L["Admin_PayLog_Title"]</h2>
    <a asp-action="Create" class="btn btn-success btn-with-icon">@Html.UiIcon("add")<span>+ @L["Admin_PayLog_Add"]</span></a>
</div>
<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sortBy" value="@filter.SortBy" />
    <input type="hidden" name="sortDesc" value="@(filter.SortDesc ? "true" : "false")" />
    <div class="col-md-3">
        <input type="text" name="keyword" value="@filter.Keyword" class="form-control" placeholder="@L["Admin_PayLog_SearchPh"]" />
    </div>
    <div class="col-md-2">
        <input type="date" name="startDate" value="@filter.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="date" name="endDate" value="@filter.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary btn-with-icon">@Html.UiIcon("search")<span>@L["Common_Search"]</span></button></div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-sm" data-grid-sort="server">
        <thead class="table-dark">
            <tr>
                <th class="@GridSortHelper.ThClass(filter, "tbKey")" data-sort="tbKey">TbKey<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "imei")" data-sort="imei">IMEI<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "member")" data-sort="member">@L["Admin_PayLog_Member"]<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "amount")" data-sort="amount">@L["Admin_PayLog_Amount"]<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "saleModel")" data-sort="saleModel">@L["Admin_PayLog_SaleModel"]<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "sdate")" data-sort="sdate">@L["Admin_PayLog_ServiceFrom"]<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "edate")" data-sort="edate">@L["Admin_PayLog_ServiceTo"]<span class="sort-ind"></span></th>
                <th class="@GridSortHelper.ThClass(filter, "cdate")" data-sort="cdate">@L["Field_CreatedDate"]<span class="sort-ind"></span></th>
                <th>@L["Common_Operation"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>@p.TbKey</td>
                    <td>@p.IMEICODE</td>
                    <td>@p.MemberName</td>
                    <td>@p.Amount.ToString("N0")</td>
                    <td>@p.SaleModel</td>
                    <td>@p.SDate?.ToString("yyyy-MM-dd")</td>
                    <td>@p.EDate?.ToString("yyyy-MM-dd")</td>
                    <td>@p.CDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@p.TbKey" class="btn btn-sm btn-info btn-with-icon">@Html.UiIcon("details")<span>@L["Common_Details"]</span></a>
                        <form asp-action="Delete" method="post" class="d-inline"
                              data-tp-confirm
                              data-tp-confirm-title="@L["Dialog_ConfirmDelete"]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.TbKey" />
                            <button type="submit" class="btn btn-sm btn-danger btn-with-icon">@Html.UiIcon("delete")<span>@L["Common_Delete"]</span></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center">
    <span>@string.Format(L["Common_TotalRecords"].Value, Model.TotalCount)，@string.Format(L["Common_PageInfo"].Value, Model.PageIndex, Model.TotalPages)</span>
    <div>
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-keyword="@filter.Keyword" asp-route-startDate="@filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-sortBy="@filter.SortBy" asp-route-sortDesc="@filter.SortDesc" class="btn btn-sm btn-outline-secondary btn-with-icon">@Html.UiIcon("prev")<span>@L["Common_PreviousPage"]</span></a>
        }
        @if (Model.HasNextPage)
        {
            <a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-keyword="@filter.Keyword" asp-route-startDate="@filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-sortBy="@filter.SortBy" asp-route-sortDesc="@filter.SortDesc" class="btn btn-sm btn-outline-secondary btn-with-icon">@Html.UiIcon("next")<span>@L["Common_NextPage"]</span></a>
        }
    </div>
</div>
